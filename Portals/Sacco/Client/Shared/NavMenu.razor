@inject Sacco.Shared.StateContainerService stateService


<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
     
        <a class="navbar-brand" href="Home">@stateService.company_name</a>
        <button title="Navigation menu" class="navbar-toggler" @onclick="ToggleNavMenu">
            <span class="navbar-toggler-icon"></span>
        </button>
    </div>
</div>

<div class="@NavMenuCssClass nav-scrollable" @onclick="ToggleNavMenu">
    <nav class="flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="Home" Match="NavLinkMatch.All">
                <span class="oi oi-home" aria-hidden="true"></span> Home
            </NavLink>
        </div>   <div class="nav-item px-3">
            <NavLink class="nav-link" href="Statement" Match="NavLinkMatch.All">
                <span class="oi oi-home" aria-hidden="true"></span> Statement
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="Loans">
                <span class="oi oi-plus" aria-hidden="true"></span> Loans
            </NavLink>

        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="Newloan">
                <span class="oi oi-plus" aria-hidden="true"></span> New Loan
            </NavLink>

        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="Myguarantors">
                <span class="oi oi-list-rich" aria-hidden="true"></span> My Guarantors
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="Guaranteed">
                <span class="oi oi-list-rich" aria-hidden="true"></span> Guaranteed Loans
            </NavLink>
        </div>
    </nav><a class="col px-5" href="../" target="_blank">Sign out</a>
</div>

@code {
    private bool collapseNavMenu = true;

    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }
}
