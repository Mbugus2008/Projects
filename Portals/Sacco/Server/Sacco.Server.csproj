<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EmccLinkOptimizationFlag>-Oz</EmccLinkOptimizationFlag>
    <!-- Optimize for size -->
    <WasmNativeStrip>true</WasmNativeStrip>
    <!-- Strip unused code -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Reduce ICU data size -->
    <EmccArgs>-s TOTAL_MEMORY=128MB -s INITIAL_MEMORY=64MB</EmccArgs>
    <!-- Limit memory -->
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Settings.xml" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Settings.xml">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    
    <PackageReference Include="Swashbuckle.AspNetCore" Version="9.0.3" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="9.0.6" />
    <PackageReference Include="System.Web.Services.Description" Version="8.1.2" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="8.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="8.0.0" />
<PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="8.0.0" />    
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\Logging\Logging 4\Logging 4.0.csproj" />
    <ProjectReference Include="..\Client\Sacco.Client.csproj" />
    <ProjectReference Include="..\Shared\Sacco.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Web.Services">
      <HintPath>..\..\..\Investor\System.Web.Services.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Services\" />
  </ItemGroup>


</Project>
