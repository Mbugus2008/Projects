<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.MaterialComponents.Light.DarkActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="android:autoCompleteTextViewStyle">@style/Defaultautocomplete</item>
        <item name="editTextStyle">@style/DefaultEdittext</item>
    </style>

    <style name="Defaultautocomplete" parent="android:Widget.AutoCompleteTextView">
        <item name="android:selectAllOnFocus">true</item>
    </style>
    <style name="DefaultEdittext" parent="android:Widget.EditText">
        <item name="android:selectAllOnFocus">true</item>
        <item name="android:textColorHint">#ffff</item>
    </style>
    <style name="sales" parent="@android:style/Widget.TextView">
        <item name="android:textSize">15dp</item>
        <item name="android:gravity">left|center_vertical</item>
        <item name="android:layout_width">150dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="layout_constraintStart_toStartOf">parent</item>
    </style>


    <style name="salestext" parent="@android:style/Widget.TextView">
    <item name="android:textSize">15dp</item>
    <item name="android:gravity">left|center_vertical</item>
    <item name="android:layout_width">0dp</item>
    <item name="android:layout_height">40dp</item>
    <item name="layout_constraintEnd_toEndOf">parent</item>
    <item name="layout_constraintStart_toStartOf">@id/guideline</item>
    </style>

    <style name="receiptline_item" parent="@android:style/Widget.TextView">
        <item name="android:textSize">15dp</item>
        <item name="android:gravity">right|center_vertical</item>
        <item name="android:layout_width">70dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="layout_constraintTop_toTopOf">parent</item>
        <item name="android:dropDownWidth">300dp</item>
        <item name="android:ellipsize">middle</item>
        <item name="android:singleLine">true</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
