<?xml version="1.0" encoding="utf-8"?>
<layout  xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="MissingConstraints"
    tools:context=".MainActivity">
    <data class="Sales_invoices">
        <variable
            name="invoice"
            type="com.trimline.sales.Sales_invoice" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <TextView
            android:id="@+id/customer"
            style="@style/sales"
            android:text="Customer" />

        <TextView
            android:id="@+id/Dates"
            style="@style/sales"
            android:text="Date"
            app:layout_constraintTop_toBottomOf="@id/customer" />

        <AutoCompleteTextView
            android:id="@+id/customertext"
            style="@style/salestext"
            android:text="@={invoice.Sell_to_Customer_No }"
            app:layout_constraintStart_toEndOf="@id/customer" />
        <TextView
            android:id="@+id/Date"
            style="@style/salestext"
            android:hint="Date"
            android:text="@={invoice.DocumentDate}"
            app:layout_constraintTop_toBottomOf="@id/customer" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.30" />
        <androidx.constraintlayout.widget.Group
            android:id="@+id/group"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:constraint_referenced_ids="customer,Dates,Date,customertext" />
        <Button
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/Date"
        android:id="@+id/newline"
        android:text="Add"/>

        <include
            android:id="@+id/header"
            layout="@layout/receipts_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@id/newline"
            />
        <androidx.recyclerview.widget.RecyclerView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:id="@+id/receipt_line"

            app:layout_constraintBottom_toTopOf="@id/totalst"
            app:layout_constraintTop_toBottomOf="@id/header" />
        <TextView
            android:id="@+id/totals"
            style="@style/sales"
            android:text="Total"
            android:textSize="30dp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            />
        <TextView
            android:id="@+id/totalst"
            style="@style/salestext"
            android:hint="total"
            android:textSize="30dp"
            android:textStyle="bold"
            android:gravity="right"
            android:text="@={``+invoice.Total}"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/guideline"
            />
    </androidx.constraintlayout.widget.ConstraintLayout></layout>