<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/login_bg"
    android:padding="12dp"
    app:layout_behavior="@string/appbar_scrolling_view_behavior"
    tools:context="com.trimline.paul.metro.summary"
    tools:showIn="@layout/activity_daily_summary">

    <com.google.android.material.button.MaterialButton
        android:id="@+id/Date"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:text="Select date"
        android:textColor="@color/colorPrimaryDark"
        android:textSize="15sp"
        app:cornerRadius="12dp"
        app:strokeColor="@color/colorPrimaryDark"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/showreversed"
        app:layout_constraintTop_toTopOf="parent" />

    <CheckBox
        android:id="@+id/showreversed"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_marginStart="4dp"
        android:gravity="center_vertical"
        android:text="Show reversed"
        android:textColor="@color/colorPrimaryDark"
        android:textSize="13sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/Date"
        app:layout_constraintBottom_toBottomOf="@+id/Date" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/summaryrecycler"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:clipToPadding="false"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/Date" />

    <TextView
        android:id="@+id/summaryEmpty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="No collections found"
        android:textColor="@color/loginMuted"
        android:textSize="14sp"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/summaryrecycler"
        app:layout_constraintBottom_toBottomOf="@id/summaryrecycler" />
</androidx.constraintlayout.widget.ConstraintLayout>
