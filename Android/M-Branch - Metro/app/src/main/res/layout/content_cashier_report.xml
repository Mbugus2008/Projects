<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/login_bg"
    android:padding="12dp"
    app:layout_behavior="@string/appbar_scrolling_view_behavior"
    tools:context=".reports.cashier_report"
    tools:showIn="@layout/activity_cashier_report">

    <com.google.android.material.button.MaterialButton
        android:id="@+id/cashierdate"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:text="Select date"
        android:textColor="@color/colorPrimaryDark"
        android:textSize="15sp"
        app:cornerRadius="12dp"
        app:strokeColor="@color/colorPrimaryDark"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/showreversed"
        app:layout_constraintTop_toTopOf="parent" />

    <CheckBox
        android:id="@+id/showreversed"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_marginStart="4dp"
        android:gravity="center_vertical"
        android:text="Show reversed"
        android:textColor="@color/colorPrimaryDark"
        android:textSize="13sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/cashierdate"
        app:layout_constraintBottom_toBottomOf="@+id/cashierdate" />

    <ProgressBar
        android:id="@+id/cashierprogress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/cashierrecycler"
        app:layout_constraintBottom_toBottomOf="@+id/cashierrecycler" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/cashierrecycler"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:clipToPadding="false"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/cashiertotalbar"
        app:layout_constraintTop_toBottomOf="@+id/cashierdate" />

    <TextView
        android:id="@+id/cashierEmpty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="No collections found"
        android:textColor="@color/loginMuted"
        android:textSize="14sp"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/cashierrecycler"
        app:layout_constraintBottom_toBottomOf="@id/cashierrecycler" />

    <LinearLayout
        android:id="@+id/cashiertotalbar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_card_white"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.1"
            android:text="TOTAL"
            android:textColor="@color/loginMuted"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/cashiertotal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="right"
            android:text="0.00"
            android:textColor="#2E7D32"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
