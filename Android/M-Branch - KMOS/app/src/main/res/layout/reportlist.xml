<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal">

    <RelativeLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/memberno"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:hint="Member No"
            android:textColor="#000"
            android:textSize="10dp" />

        <TextView
            android:id="@+id/membername"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/memberno"
            android:hint="Member name"
            android:textColor="#000"
            android:textSize="8dp" />

        <TextView
            android:id="@+id/reference"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="110dp"
            android:text="Reference no"
            android:textSize="8dp" />

        <TextView
            android:id="@+id/receiptno"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/reference"
            android:layout_alignRight="@id/groupcount"
            android:layout_marginLeft="110dp"
            android:text="Receipt no"
            android:textSize="8dp" />

        <TextView
            android:id="@+id/transtype"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:layout_marginLeft="20dp"
            android:layout_marginRight="15dp"
            android:hint="trans type"
            android:textColor="@android:color/holo_green_dark"
            android:textSize="8dp" />

        <TextView
            android:id="@+id/tamount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/transtype"
            android:layout_alignParentRight="true"
            android:layout_marginLeft="20dp"
            android:layout_marginRight="15dp"
            android:hint="total"
            android:textColor="@android:color/holo_green_light"
            android:textSize="10dp" />

        <ImageView
            android:id="@+id/sent"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_alignParentRight="true"
            android:layout_marginTop="5dp"
            android:src="@drawable/sent" />
    </RelativeLayout>
</RelativeLayout>