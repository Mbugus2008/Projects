<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/backgroundactionbar"
    android:descendantFocusability="blocksDescendants"
    android:focusable="false"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/vehicleno"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="30dp"
        android:layout_marginTop="7dp"
        android:focusable="false"
        android:text="Vehicle"
        android:textColor="#000"
        android:textSize="10dp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/memberno"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="200dp"
        android:focusable="false"
        android:text="Member no"
        android:textColor="#000"
        android:textSize="10dp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/membername"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/memberno"
        android:layout_alignRight="@id/memberno"
        android:layout_marginLeft="120dp"

        android:focusable="false"
        android:text="Name"
        android:textColor="#000"
        android:textSize="10dp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/vehiclecount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_above="@+id/membername"
        android:layout_alignEnd="@+id/grouptotalvalue"
        android:layout_alignRight="@+id/grouptotalvalue"
        android:layout_alignParentTop="true"
        android:focusable="false"
        android:gravity="right"
        android:hint="Count"
        android:textColor="#000"
        android:textSize="10dp" />

    <TextView
        android:id="@+id/grouptotalvalue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/vehiclecount"
        android:layout_alignParentEnd="true"
        android:layout_alignParentRight="true"

        android:focusable="false"
        android:gravity="right"
        android:hint="total"
        android:textColor="#000"
        android:textSize="10dp" />

</RelativeLayout>