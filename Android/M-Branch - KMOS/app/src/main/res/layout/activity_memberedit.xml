<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/activity_memberedit"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context="com.trimline.paul.m_branch.memberedit">

    <TextView
        android:id="@+id/mno"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:text="No" />

    <TextView
        android:id="@+id/mname"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/mno"
        android:layout_centerHorizontal="true"
        android:text="Name" />

    <EditText
        android:id="@+id/idno"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/mname"
        android:layout_centerHorizontal="true"
        android:hint="Id no" />

    <EditText
        android:id="@+id/phone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/idno"
        android:layout_centerHorizontal="true"
        android:hint="Phone number" />

    <Button
        android:id="@+id/updatemember"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/phone"
        android:layout_centerHorizontal="true"
        android:text="Update" />

    <Button
        android:id="@+id/cancel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/updatemember"
        android:layout_centerHorizontal="true"
        android:text="Cancel" />

</RelativeLayout>
