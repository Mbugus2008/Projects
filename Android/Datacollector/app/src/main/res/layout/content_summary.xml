<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/content_summary"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:layout_behavior="@string/appbar_scrolling_view_behavior"
    tools:context="com.trimline.paul.datacollector.summary"
    tools:showIn="@layout/activity_summary">


    <Button
        android:id="@+id/btnFromDate"
        android:layout_width="match_parent"

        android:layout_height="wrap_content"

        android:text="From Date" />

    <Button
        android:id="@+id/btnToDate"
        android:layout_width="match_parent"

        android:layout_height="wrap_content"
        android:layout_below="@id/btnFromDate"
        android:text="To Date" />
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/summaryRecycler"
        android:layout_below="@id/btnToDate"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
<ExpandableListView
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:groupIndicator="@null"
    android:visibility="gone"
    android:indicatorLeft="?android:attr/expandableListPreferredItemIndicatorLeft"
    android:divider="@android:color/darker_gray"
    android:id="@+id/summary"
    android:layout_below="@id/btnFromDate"
    android:dividerHeight="0.5dp" />



</RelativeLayout>
