<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:bind="http://schemas.android.com/apk/res-auto"
    >
    <data class="Loanrequest">
        <variable
            name="loan"
            type="com.trimline.pawdep.Loan_Request" />
    </data>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:descendantFocusability="afterDescendants"
        android:scrollbars="horizontal"
        android:background="@drawable/border"

        tools:ignore="MissingConstraints"
        >

        <AutoCompleteTextView
            android:id="@+id/Groupname"
            android:layout_width="200dp"
            style="@style/loan_request_header"
            android:text="@={loan.Group_Name}"
            android:completionThreshold="3"
            android:dropDownWidth="300dp"
            app:layout_constraintStart_toStartOf="parent"
            android:enabled="@{!loan.sent}"
           />

        <AutoCompleteTextView
            android:id="@+id/memberNo"
            style="@style/loan_request_header"
            android:hint="PAWDEP No"
            android:text="@={loan.Member_Code}"
            android:completionThreshold="1"
            android:dropDownWidth="300dp"
            app:layout_constraintStart_toEndOf="@id/Groupname"
            app:layout_constraintTop_toTopOf="parent"
            android:enabled="@{!loan.sent}"
          />

        <TextView
            android:id="@+id/Member_Name"
            android:layout_width="200dp"
            style="@style/loan_request_header"
            android:hint="Name"
            android:text="@={loan.Member_Name}"
            app:layout_constraintStart_toEndOf="@id/memberNo"
             />

        <AutoCompleteTextView
            android:id="@+id/sector"
            style="@style/loan_request_header"
            android:hint="Sector"

            android:text="@={loan.Sector}"
            android:completionThreshold="1"
            android:dropDownWidth="300dp"
            app:layout_constraintStart_toEndOf="@id/Member_Name"
            android:enabled="@{!loan.sent}"
        />

        <AutoCompleteTextView
            android:id="@+id/subsector"
            style="@style/loan_request_header"
            android:hint="Sub sector"
            android:text="@={loan.Sub_Sector}"
            android:completionThreshold="1"
            android:dropDownWidth="300dp"
            app:layout_constraintStart_toEndOf="@id/sector"
            android:enabled="@{!loan.sent}"
            />
        <AutoCompleteTextView
            android:id="@+id/Loantype"
            style="@style/loan_request_header"
            android:hint="Loan type"

            android:text="@={loan.Loan_Type}"
            android:completionThreshold="1"
            android:dropDownWidth="300dp"
            app:layout_constraintStart_toEndOf="@id/subsector"
            android:enabled="@{!loan.sent}"
            />
        <EditText
            android:id="@+id/Amountapplied"
            style="@style/loan_request_header"
            android:hint="Amount"

            android:text="@={`` +loan.Amount_Applied}"
           android:gravity="right"
            android:inputType="number"
            app:layout_constraintStart_toEndOf="@id/Loantype"
            android:enabled="@{!loan.sent}"
            />
 <ImageView
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:src="@drawable/guarantor"
    android:id="@+id/guarantors"
     android:scaleType="fitXY"
     android:layout_marginEnd="20dp"
    app:layout_constraintTop_toTopOf="parent"
    app:layout_constraintEnd_toStartOf="@id/clear"

    />

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/deletered"
            android:id="@+id/clear"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            />
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>