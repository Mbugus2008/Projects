<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Group_loan_issue">
    <androidx.constraintlayout.widget.ConstraintLayout
    android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/c1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        >
     <TextView
        android:id="@+id/loanno"
        android:layout_width="150dp"
        android:layout_height="wrap_content"
        android:text="Loan No"
        android:theme="@style/tlistheader"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
    <TextView
        android:id="@+id/PAWDEP_No"
        android:layout_width="150dp"
        android:layout_height="wrap_content"
        android:text="Pawdep No"
        android:textSize="15dp"
        android:gravity="center"
        app:layout_constraintStart_toEndOf="@id/loanno"
        app:layout_constraintTop_toTopOf="parent" />
    <TextView
        android:id="@+id/Member_Name"
        android:layout_width="150dp"
        android:layout_height="wrap_content"
        android:text="Name"
        android:textSize="15dp"
        android:gravity="center"
        app:layout_constraintStart_toEndOf="@id/PAWDEP_No"
        app:layout_constraintTop_toTopOf="parent" />
    <TextView
        android:id="@+id/Amountapplied"
        android:text="Applied"
        style="@style/grouploansheader"
        app:layout_constraintStart_toEndOf="@id/Member_Name"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/Amountapproved"
        android:text="Approved"
        style="@style/grouploansheader"
        app:layout_constraintStart_toEndOf="@id/Amountapplied"
        app:layout_constraintTop_toTopOf="parent" />
    <TextView
        android:id="@+id/Disbursedamount"
        android:text="Disbursed"
        style="@style/grouploansheader"
        app:layout_constraintStart_toEndOf="@id/Amountapproved"
        app:layout_constraintTop_toTopOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/c1"
        android:id="@+id/grouploan"
        >
    </androidx.recyclerview.widget.RecyclerView>
</androidx.constraintlayout.widget.ConstraintLayout>