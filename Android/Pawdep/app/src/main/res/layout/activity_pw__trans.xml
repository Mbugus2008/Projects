<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".PW_Trans">

    <TextView
        android:id="@+id/PAWDEP_No"
        android:layout_width="150dp"
        android:layout_height="wrap_content"
        android:text="Pawdep No"
        android:textSize="15dp"
        android:gravity="center"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/Member_Name"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:text="Name"
        android:textSize="15dp"
        android:gravity="center"
        app:layout_constraintStart_toEndOf="@id/PAWDEP_No"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/ttype"

        android:text="Transaction Type"
        style="@style/pwtrans"
        app:layout_constraintStart_toEndOf="@id/Member_Name"
        app:layout_constraintTop_toTopOf="parent" />
    <TextView
        android:id="@+id/Amount"
        android:text="Amount"
        style="@style/pwtrans"
        app:layout_constraintStart_toEndOf="@id/ttype"
        app:layout_constraintTop_toTopOf="parent" />


    <androidx.recyclerview.widget.RecyclerView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/PAWDEP_No"
        android:id="@+id/pwtrans"
        >
    </androidx.recyclerview.widget.RecyclerView>
</androidx.constraintlayout.widget.ConstraintLayout>