<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"  android:layout_width="match_parent"
    android:paddingStart="10dp"
    android:background="@drawable/header"
    android:layout_height="wrap_content">
  <ImageView
      android:layout_width="wrap_content"
      android:layout_height="0dp"
      app:layout_constraintStart_toStartOf="parent"
      android:src="@drawable/action_new"
      app:layout_constraintBottom_toBottomOf="parent"
      app:layout_constraintTop_toTopOf="parent"
      android:id="@+id/newmember"/>
    <TextView
        android:id="@+id/member_PAWDEP_No"
        android:layout_width="150dp"
        android:layout_marginStart="50dp"
        android:layout_height="wrap_content"
        android:textStyle="bold"
        android:textSize="15dp"
        android:ellipsize="start"
        android:singleLine="true"
        android:text="No"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/member_Member_Name"
        android:layout_width="200dp"
        android:layout_marginStart="50dp"
        android:layout_height="wrap_content"
        android:textStyle="bold"
        android:text="Name"
        android:textSize="15dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/member_PAWDEP_No"
        />


    <TextView
        android:id="@+id/member_Loan_Principle_Paid"
        style="@style/groupsummaryheader"
        android:text="Principle Paid"
        app:layout_constraintEnd_toEndOf="@id/member_Loan_Interest_Paid"
        app:layout_constraintStart_toEndOf="@id/member_PAWDEP_No"
        app:layout_constraintTop_toTopOf="parent" />
    <TextView
        android:id="@+id/member_Loan_Interest_Paid"
        style="@style/groupsummaryheader"
        android:text="Interest Paid"
        app:layout_constraintStart_toEndOf="@id/member_Loan_Principle_Paid"
        app:layout_constraintTop_toTopOf="parent"
        />

    <TextView
        android:id="@+id/member_Advance_Principle_Paid"
        style="@style/groupsummaryheader"
        android:text="Adv. Prin. Paid"
        app:layout_constraintStart_toEndOf="@id/member_Loan_Interest_Paid"
        app:layout_constraintTop_toTopOf="parent" />
    <TextView
        android:id="@+id/member_Advance_Interest_Paid"
        style="@style/groupsummaryheader"
        android:text="Adv. Int. Paid"
        app:layout_constraintStart_toEndOf="@id/member_Advance_Principle_Paid"
        app:layout_constraintTop_toTopOf="parent" />
    <TextView
        android:id="@+id/member_Savingsreceived"
        style="@style/groupsummaryheader"
        android:text="Monthly Savings"
        app:layout_constraintStart_toEndOf="@id/member_Advance_Interest_Paid"
        app:layout_constraintTop_toTopOf="parent" />
    <TextView
        android:id="@+id/member_Fines"
        style="@style/groupsummaryheader"
        android:text="Fines"
        app:layout_constraintStart_toEndOf="@id/member_Savingsreceived"
        app:layout_constraintTop_toTopOf="parent" />
    <TextView
        android:id="@+id/member_Advanceissue"
        style="@style/groupsummaryheader"
        android:text="Advances Issued"
        app:layout_constraintStart_toEndOf="@id/member_Fines"
        app:layout_constraintTop_toTopOf="parent" />
    <TextView
        android:id="@+id/member_Othertrans"
        style="@style/groupsummaryheader"
        android:text="Other Trans"
        app:layout_constraintStart_toEndOf="@id/member_Advanceissue"
        app:layout_constraintTop_toTopOf="parent" />
    <TextView
        android:id="@+id/member_Hall"
        style="@style/groupsummaryheader"
        android:text="Hall"
        app:layout_constraintStart_toEndOf="@id/member_Othertrans"
       app:layout_constraintTop_toTopOf="parent" />
    <TextView
        android:id="@+id/member_totalpaid"
        style="@style/groupsummaryheader"
        android:textStyle="bold"
        android:text="Total"
        android:layout_marginEnd="120dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>