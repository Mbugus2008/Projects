<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Loan_history"
    tools:ignore="MissingConstraints" >
    <TextView
        style="@style/loan_history"
        android:id="@+id/loanhistory_LoanNo"
        android:text="Loan No"
        app:layout_constraintStart_toStartOf="parent"
      />
    <TextView
        style="@style/loan_history"
        android:id="@+id/loanhistory_Type"
        android:text="Loan Type"
         app:layout_constraintStart_toEndOf="@id/loanhistory_LoanNo"
        />
    <TextView
        style="@style/loan_history"
        android:id="@+id/loanhistory_DisbursementDate"
        android:text="Disbursement date"
        app:layout_constraintStart_toEndOf="@id/loanhistory_Type"
        />

    <TextView
        style="@style/loan_history"
        android:id="@+id/loanhistory_Balance"
        android:text="Balance"
        app:layout_constraintStart_toEndOf="@id/loanhistory_DisbursementDate"
        />
    <TextView
        style="@style/loan_history"
        android:id="@+id/loanhistory_lastDatepaid"
        android:text="Lastly paid"
        app:layout_constraintStart_toEndOf="@id/loanhistory_Balance"
        />
    <androidx.recyclerview.widget.RecyclerView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:id="@+id/loanhistory"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/loanhistory_lastDatepaid" />
</androidx.constraintlayout.widget.ConstraintLayout>