<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:bind="http://schemas.android.com/apk/res-auto"
    >
    <data class="Advanceissue">
        <variable
            name="advanceissue"
            type="com.trimline.pawdep.Advance" />

    </data>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:descendantFocusability="afterDescendants"
        android:scrollbars="horizontal"
        android:background="@drawable/border"
        >
        <TextView
            android:id="@+id/Loan_No"
            android:layout_width="80dp"
            android:layout_height="wrap_content"
            android:hint="PAWDEP No"
            android:text="@={advanceissue.Adv_Loan_No}"
            android:textSize="10dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="@id/PAWDEP_No"/>
        <AutoCompleteTextView
            android:id="@+id/PAWDEP_No"
            android:layout_width="150dp"
            android:layout_height="wrap_content"
            android:hint="PAWDEP No"
            android:textSize="15dp"
            android:text="@={advanceissue.Pawdep_No}"
            android:completionThreshold="1"
            android:dropDownWidth="300dp"
            app:layout_constraintStart_toEndOf="@id/Loan_No"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="@id/PAWDEP_No"/>
        <TextView
            android:id="@+id/memberNo"
            android:layout_width="100dp"
            android:layout_height="wrap_content"
            android:hint="Member No"
            android:text="@={advanceissue.Member_No}"
            android:textSize="10dp"
            app:layout_constraintBottom_toBottomOf="@id/PAWDEP_No"
            app:layout_constraintStart_toEndOf="@id/PAWDEP_No"
            app:layout_constraintTop_toTopOf="parent" />
        <TextView
            android:id="@+id/Member_Name"
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:hint="Name"
            android:text="@={advanceissue.Member_Name}"
            app:layout_constraintBottom_toBottomOf="@id/PAWDEP_No"
            app:layout_constraintStart_toEndOf="@id/memberNo"
            app:layout_constraintTop_toTopOf="parent" />
        <EditText
            android:id="@+id/Amount"
            android:layout_width="100dp"
            android:layout_height="wrap_content"
            android:hint="Amount"
            android:text="@={`` +advanceissue.Amount}"
            style="@style/grouptrans"
            android:selectAllOnFocus="true"
            android:inputType="number"
            app:layout_constraintBottom_toBottomOf="@id/PAWDEP_No"
            app:layout_constraintStart_toEndOf="@id/Member_Name"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/Installments"
            android:layout_width="100dp"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="@id/PAWDEP_No"
            android:hint="Installments"
            android:text="@={``+advanceissue.Instalments}"
            style="@style/groupheader"
            app:layout_constraintStart_toEndOf="@id/Amount"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/Advancefees"
            android:layout_width="100dp"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="@id/PAWDEP_No"
            android:hint="Advance Fee"
            android:text="@={``+advanceissue.Advance_Fees }"
            style="@style/groupheader"
            app:layout_constraintStart_toEndOf="@id/Installments"
            app:layout_constraintTop_toTopOf="parent"
            />

<ImageView
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:src="@drawable/deletered"
    android:id="@+id/clear"
    app:layout_constraintTop_toTopOf="parent"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintBottom_toBottomOf="@id/PAWDEP_No"
    />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>