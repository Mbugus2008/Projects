<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:bind="http://schemas.android.com/apk/res-auto"
    >
    <data class="Pwtrans">
        <variable
            name="pwtrans"
            type="com.trimline.pawdep.PW_Transactions" />

    </data>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:descendantFocusability="afterDescendants"
        android:scrollbars="horizontal"
        android:background="@drawable/border"
        >

        <AutoCompleteTextView
            android:id="@+id/PAWDEP_No"
            android:layout_width="150dp"
            android:layout_height="wrap_content"
            android:hint="PAWDEP No"
            android:textSize="15dp"
            android:text="@={pwtrans.Pawdep_No}"
            android:completionThreshold="1"
            android:dropDownWidth="300dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="@id/PAWDEP_No"/>

        <TextView
            android:id="@+id/Member_Name"
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:hint="Name"
            android:text="@={pwtrans.member_Name}"
            app:layout_constraintBottom_toBottomOf="@id/PAWDEP_No"
            app:layout_constraintStart_toEndOf="@id/PAWDEP_No"
            app:layout_constraintTop_toTopOf="parent" />

        <AutoCompleteTextView
            android:id="@+id/ttyespinner"
            android:layout_width="150dp"
            android:layout_height="wrap_content"
            android:hint="PAWDEP No"
            android:textSize="15dp"
            android:text="@={pwtrans.TransactionType}"
            android:completionThreshold="1"
            android:dropDownWidth="wrap_content"

            app:layout_constraintStart_toEndOf="@id/Member_Name"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="@id/PAWDEP_No"/>


        <EditText
            android:id="@+id/Amount"

            android:hint="Amount"
            android:text="@={`` +pwtrans.Amount}"
            style="@style/pwtrans"
            android:selectAllOnFocus="true"
            android:inputType="numberSigned"
            app:layout_constraintBottom_toBottomOf="@id/PAWDEP_No"
            app:layout_constraintStart_toEndOf="@id/ttyespinner"
            app:layout_constraintTop_toTopOf="parent" />



<ImageView
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:src="@drawable/deletered"
    android:id="@+id/clear"
    app:layout_constraintTop_toTopOf="parent"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintBottom_toBottomOf="@id/PAWDEP_No"
    />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>