<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:bind="http://schemas.android.com/apk/res-auto"
    >
    <data class="Loanhistory">
        <variable
            name="loan"
            type="com.trimline.pawdep.Loan" />
    </data>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:descendantFocusability="afterDescendants"
        android:scrollbars="horizontal"
        android:background="@drawable/border"
        tools:ignore="MissingConstraints"
        >
        <TextView
            style="@style/loan_history"

            android:id="@+id/loanhistory_LoanNo"
            android:hint="Loan No"
            android:text="@={loan.Loan_No}"
            app:layout_constraintStart_toStartOf="parent"
            />
        <TextView
            style="@style/loan_history"
            android:id="@+id/loanhistory_Type"
            android:hint="Loan Type"
            android:text="@={loan.Loan_Type}"
            app:layout_constraintStart_toEndOf="@id/loanhistory_LoanNo"
            />
        <TextView
            style="@style/loan_history"
            android:id="@+id/loanhistory_DisbursementDate"
            android:hint="Disbursement date"
            android:text="@={loan.Disbursement_Date}"
            app:layout_constraintStart_toEndOf="@id/loanhistory_Type"
            />

        <TextView
            style="@style/loan_history"
            android:id="@+id/loanhistory_Balance"
            android:hint="Balance"
            android:text="@={``+loan.Outstanding_Balance}"
            app:layout_constraintStart_toEndOf="@id/loanhistory_DisbursementDate"
            android:gravity="right|center_vertical"
            android:paddingEnd="20dp"
            />
        <TextView
            style="@style/loan_history"
            android:id="@+id/loanhistory_lastDatepaid"

            android:date="@={loan.Latest_Payment_Date}"
            app:layout_constraintStart_toEndOf="@id/loanhistory_Balance"
            />
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>