<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">
    <data class="Additem">

        <variable
            name="transaction"
            type="com.trimline.pawdep.Transaction" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"

        tools:context=".addedittrans">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:id="@+id/c1"
        android:background="@drawable/groupbox"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_height="wrap_content">
        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideline2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.5" />

        <TextView
            android:id="@+id/groupname"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:layout_marginLeft="10dp"
            android:gravity="left|center"
            android:text="Group Name"
            app:layout_constraintBottom_toBottomOf="@id/Group_Name"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />


        <AutoCompleteTextView
            android:id="@+id/Group_Name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:completionThreshold="3"
            android:dropDownWidth="wrap_content"
            android:hint="Group Name"
            android:text="@={transaction.Group_Name}"
            app:layout_constraintEnd_toEndOf="@id/guideline2"
            app:layout_constraintStart_toStartOf="@id/guideline"
            app:layout_constraintTop_toTopOf="parent" />


        <TextView
            android:id="@+id/groupbranchname"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:gravity="left|center"
            android:text="Branch Name"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/Group_Name" />


        <TextView
            android:id="@+id/groupbranch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="left|center"
            android:hint="Branch Name"
            android:text="@={transaction.Branch_Name}"
            app:layout_constraintStart_toStartOf="@id/guideline"
            app:layout_constraintTop_toBottomOf="@id/Group_Name" />

        <TextView
            android:id="@+id/dateview"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:layout_marginLeft="10dp"
            android:gravity="left|center"
            android:text="Date"
            app:layout_constraintBottom_toBottomOf="@id/date"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/groupbranch" />


        <EditText
            android:id="@+id/date"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="false"
            android:hint="Date"
            android:text="@={transaction.StringDate }"
            app:layout_constraintEnd_toEndOf="@id/guideline2"
            app:layout_constraintStart_toStartOf="@id/guideline"
            app:layout_constraintTop_toBottomOf="@id/groupbranchname" />

        <TextView
            android:id="@+id/descview"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:layout_marginLeft="10dp"
            android:gravity="left|center"
            android:text="Description"
            app:layout_constraintBottom_toBottomOf="@id/desc"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/dateview" />


        <EditText
            android:id="@+id/desc"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="Description"
            android:text="@={transaction.Description}"
            app:layout_constraintEnd_toEndOf="@id/guideline2"
            app:layout_constraintStart_toStartOf="@id/guideline"
            app:layout_constraintTop_toBottomOf="@id/date" />

        <TextView
            android:id="@+id/hallview"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:layout_marginLeft="10dp"
            android:gravity="left|center"
            android:text="Hall Paid"
            app:layout_constraintBottom_toBottomOf="@id/hallpaid"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/desc" />


        <EditText
            android:id="@+id/hallpaid"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="Hall Paid"
            android:inputType="number"
            android:text="@={``+transaction.Hall_Paid}"
            app:layout_constraintEnd_toEndOf="@id/guideline2"
            app:layout_constraintStart_toStartOf="@id/guideline"
            app:layout_constraintTop_toBottomOf="@id/desc" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"

            android:gravity="left"
            android:id="@+id/totalpaid"
            android:text="Total Paid"
            app:layout_constraintEnd_toEndOf="@id/guideline"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/hallview"  />

        <TextView
            android:id="@+id/totalpaidtxt"
            style="@style/totals"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="Total Paid"
            android:text='@{String. format("%,.2f",transaction.TotalPaid)}'
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="@id/guideline2"
            app:layout_constraintStart_toStartOf="@id/guideline"
            app:layout_constraintTop_toBottomOf="@id/hallpaid"
             />
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"

            android:gravity="left"
            android:id="@+id/Noncash"
            android:text="Non Cash"
            app:layout_constraintEnd_toEndOf="@id/guideline"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/totalpaid"  />

        <TextView
            android:id="@+id/Noncashtext"
            style="@style/totals"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="Non cash"
            android:text='@{String. format("%,.2f",transaction.NonCash)}'
            app:layout_constraintEnd_toEndOf="@id/guideline2"
            app:layout_constraintStart_toStartOf="@id/guideline"
            app:layout_constraintTop_toBottomOf="@id/totalpaidtxt"
            />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:gravity="left|center"
            android:text="Penalty"
            app:layout_constraintStart_toStartOf="@id/guideline2"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/penalty"
            style="@style/totals"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="Penalty"
            android:text='@{String. format("%,.2f",transaction.Penalty)}'
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@id/guideline3"
            app:layout_constraintTop_toTopOf="parent"
            tools:layout_editor_absoluteX="206dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:gravity="left|center"
            android:text="Principal Paid"
            app:layout_constraintStart_toStartOf="@id/guideline2"
            app:layout_constraintTop_toBottomOf="@id/penalty" />

        <TextView
            android:id="@+id/Loan_Principle_Paid"
            style="@style/totals"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="Principal Paid"

            android:text='@{String. format("%,.2f",transaction.Loan_Principle_Paid)}'
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@id/guideline3"
            app:layout_constraintTop_toBottomOf="@id/penalty"
            />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:gravity="left|center"
            android:text="Interest Paid"
            app:layout_constraintStart_toStartOf="@id/guideline2"
            app:layout_constraintTop_toBottomOf="@id/Loan_Principle_Paid" />

        <TextView
            android:id="@+id/Loan_Interest_Paid"
            style="@style/totals"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="Interest Paid"

            android:text='@{String. format("%,.2f",transaction.Loan_Interest_Paid)}'
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@id/guideline3"
            app:layout_constraintTop_toBottomOf="@id/Loan_Principle_Paid"
            />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:gravity="left|center"
            android:text="Savings Rec."
            app:layout_constraintStart_toStartOf="@id/guideline2"
            app:layout_constraintTop_toBottomOf="@id/Loan_Interest_Paid" />

        <TextView
            android:id="@+id/Savingsreceived"
            style="@style/totals"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="Savings Received"

            android:text='@{String. format("%,.2f",transaction.Savings_Received)}'
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@id/guideline3"
            app:layout_constraintTop_toBottomOf="@id/Loan_Interest_Paid"
            />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:gravity="left|center"
            android:text="Fines"
            app:layout_constraintStart_toStartOf="@id/guideline2"
            app:layout_constraintTop_toBottomOf="@id/Savingsreceived" />

        <TextView
            android:id="@+id/Fines"
            style="@style/totals"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="Fines"

            android:text='@{String. format("%,.2f",transaction.Group_Fines)}'
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@id/guideline3"
            app:layout_constraintTop_toBottomOf="@id/Savingsreceived"
          />


        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:gravity="left|center"
            android:text="Adv.Prin. Paid"
            app:layout_constraintStart_toStartOf="@id/guideline2"
            app:layout_constraintTop_toBottomOf="@id/Fines" />

        <TextView
            android:id="@+id/Advance_Principle_Paid"
            style="@style/totals"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="Advance Principal"

            android:text='@{String. format("%,.2f",transaction.Advance_Principle_Paid)}'

            app:layout_constraintTop_toBottomOf="@id/Fines"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@id/guideline3" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:gravity="left|center"
            android:text="Adv.Int. Paid"
            app:layout_constraintStart_toStartOf="@id/guideline2"
            app:layout_constraintTop_toBottomOf="@id/Advance_Principle_Paid" />

        <TextView
            android:id="@+id/Advance_Interest_Paid"
            style="@style/totals"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="Advance Interest"

            android:text='@{String. format("%,.2f",transaction.Advance_Interest_Paid)}'
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@id/guideline3"
            app:layout_constraintTop_toBottomOf="@id/Advance_Principle_Paid"
             />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:gravity="left|center"
            android:text="Adv Penalty"
            app:layout_constraintStart_toStartOf="@id/guideline2"
            app:layout_constraintTop_toBottomOf="@id/Advance_Interest_Paid" />

        <TextView
            android:id="@+id/Advance_penalty"
            style="@style/totals"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="Advance Penalty"

            android:text='@{String. format("%,.2f",transaction.Advance_Penalty)}'
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@id/guideline3"
            app:layout_constraintTop_toBottomOf="@id/Advance_Interest_Paid"
            />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:gravity="left|center"
            android:text="Advances Issued"
            app:layout_constraintStart_toStartOf="@id/guideline2"
            app:layout_constraintTop_toBottomOf="@id/Advance_penalty" />

        <TextView
            android:id="@+id/Advanceissued"
            style="@style/totals"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="Advance Issued"

            android:text='@{String. format("%,.2f",transaction.Advances_Issued)}'
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@id/guideline3"
            app:layout_constraintTop_toBottomOf="@id/Advance_penalty"
           />


        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:gravity="left|center"
            android:text="Advance Fees"
            app:layout_constraintStart_toStartOf="@id/guideline2"
            app:layout_constraintTop_toBottomOf="@id/Advanceissued" />

        <TextView
            android:id="@+id/Advancefees"
            style="@style/totals"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="Advance Fees"
            android:text='@{String. format("%,.2f",transaction.Advance_Fees)}'
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@id/guideline3"
            app:layout_constraintTop_toBottomOf="@id/Advanceissued"
           />


        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:gravity="left|center"
            android:text="Other Transactions"
            app:layout_constraintStart_toStartOf="@id/guideline2"
            app:layout_constraintTop_toBottomOf="@id/Advancefees" />

        <TextView
            android:id="@+id/Othertrans"
            style="@style/totals"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="Other Transactions"

            android:text='@{String. format("%,.2f",transaction.Other_Transactions_Paid)}'
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@id/guideline3"
            app:layout_constraintTop_toBottomOf="@id/Advancefees"
             />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:gravity="left|center"
            android:text="Hall Received"
            app:layout_constraintStart_toStartOf="@id/guideline2"
            app:layout_constraintTop_toBottomOf="@id/Othertrans" />

        <TextView
            android:id="@+id/Hall"
            style="@style/totals"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="Hall"

            android:text='@{String. format("%,.2f",transaction.Hall_Received)}'
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@id/guideline3"
            app:layout_constraintTop_toBottomOf="@id/Othertrans"
            />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:gravity="left|center"
            android:text="Till"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="@id/guideline2"
            app:layout_constraintTop_toBottomOf="@id/Hall" />

        <TextView
            android:id="@+id/Till"
            style="@style/totals"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="Till"

            android:text='@{String. format("%,.2f",transaction.Credit_Officer_Totals)}'
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@id/guideline3"
            app:layout_constraintTop_toBottomOf="@id/Hall"
          />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.15" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideline3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.75" />
    </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            app:layout_constraintTop_toBottomOf="@id/c1"
            android:background="@drawable/groupbox"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            >
        <include
            layout="@layout/membersummaryheader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/header"
            app:layout_constraintTop_toTopOf="parent"

            />
        <androidx.recyclerview.widget.RecyclerView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintTop_toBottomOf="@id/header"
            app:layout_constraintBottom_toBottomOf="parent"
            android:id="@+id/groupmembersummarylist"
            android:scrollbars="vertical"
            ></androidx.recyclerview.widget.RecyclerView>
    </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>