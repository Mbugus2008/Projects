<?xml version="1.0" encoding="utf-8"?>

<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:context=".addeditmember"
    tools:ignore="MissingConstraints">
    <data class="Memberbinding">

        <variable
            name="member"
            type="com.trimline.pawdep.Member" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:id="@+id/caption"
        app:layout_constraintStart_toStartOf="parent"
        >
                <TextView
                style="@style/member"
                android:text="Group Name"
                />
                <TextView
                    style="@style/member"
                    android:text="Group No"
                    />
                <TextView
                    style="@style/member"
                    android:text="No"
                 />
                <TextView
                    style="@style/member"
                    android:text="Member no"
                    />
                <TextView
                    style="@style/member"
                    android:text="Name" />
                <TextView
                    style="@style/member"
                    android:text="Phone" />
                <TextView
                    style="@style/member"
                    android:text="ID No" />
                <TextView
                    style="@style/member"
                    android:text="Gender" />

        </LinearLayout>
        <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
            app:layout_constraintStart_toEndOf="@id/caption"
            >
            <TextView
                style="@style/member"
                android:hint="Group Name"
                android:text="@={member.Group_Name}"
                />
            <TextView
                style="@style/member"
                android:hint="Group No"
                android:text="@={member.Group_No}"
                />
            <TextView
                style="@style/member"
                android:hint="No"
                android:text="@={member.No}"
                />
            <EditText
                style="@style/member"
                android:hint="Member No"
                android:inputType="number"
                android:text="@={member.GID}"
                />
            <EditText
                style="@style/member"
                android:hint="Name"
                android:layout_width="300dp"
                android:id="@+id/name"
                android:text="@={member.Name}" />
            <EditText
                style="@style/member"
                android:id="@+id/phone"
                android:hint="+254700000000"
                android:text="@={member.Phone_No}"  />
             <EditText
                style="@style/member"
                android:hint="ID No"
                 android:id="@+id/idno"
                android:text="@={member.ID_No}"/>
            <AutoCompleteTextView
                style="@style/member"
                android:id="@+id/gender"
                android:hint="select Gender"

                android:text="@={member.Genderr}"/>

    </LinearLayout>


    </androidx.constraintlayout.widget.ConstraintLayout></layout>