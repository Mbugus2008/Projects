<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"  android:layout_width="match_parent"
    tools:ignore="MissingConstraints"
    android:background="@drawable/header"
    android:layout_height="wrap_content">
  
    <TextView
        android:id="@+id/member_groupname"
        android:layout_width="200dp"
        style="@style/loan_request_header"
        android:text="Group Name"
        app:layout_constraintStart_toStartOf="parent"
         />

    <TextView
        android:id="@+id/member_PAWDEP_No"
        style="@style/loan_request_header"
        android:text="Pawdep No"
        app:layout_constraintStart_toEndOf="@id/member_groupname"
         />

    <TextView
        android:id="@+id/member_Member_Name"
        style="@style/loan_request_header"
        android:layout_width="200dp"
        android:text="Name"
        app:layout_constraintStart_toEndOf="@id/member_PAWDEP_No"

        />
    <TextView
        android:id="@+id/sector"
       style="@style/loan_request_header"
        android:text="Sector"
        app:layout_constraintStart_toEndOf="@id/member_Member_Name"
      />

    <TextView
        android:id="@+id/currentloan"
        style="@style/loan_request_header"
        android:text="Sub Sector"
        app:layout_constraintStart_toEndOf="@id/sector"
        app:layout_constraintTop_toTopOf="parent"
        />
    <TextView
        android:id="@+id/Savings"
        style="@style/loan_request_header"
        android:text="Loan type"
        app:layout_constraintStart_toEndOf="@id/currentloan"
      />
    <TextView
        android:id="@+id/Amountapplied"
        style="@style/loan_request_header"
        android:text="Amount Applied"
        app:layout_constraintStart_toEndOf="@id/Savings"
      />

   
</androidx.constraintlayout.widget.ConstraintLayout>