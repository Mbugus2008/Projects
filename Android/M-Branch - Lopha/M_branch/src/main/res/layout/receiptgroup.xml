<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/backgroundactionbar"
    android:descendantFocusability="blocksDescendants"
    android:focusable="false"
    android:orientation="horizontal">

    <ImageButton
        android:id="@+id/reverse"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_alignParentStart="true"
        android:layout_alignParentLeft="true"
        android:layout_marginLeft="30dp"
        android:layout_marginTop="5dp"
        android:background="@null"
        android:focusable="false"

        android:src="@drawable/deletered" />

    <TextView
        android:id="@+id/lblListHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="55dp"
        android:layout_marginLeft="55dp"
        android:focusable="false"

        android:text="Date"
        android:textColor="@android:color/holo_green_dark"
        android:textSize="10dp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/lblListreceipt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/lblListHeader"
        android:layout_marginStart="55dp"
        android:layout_marginLeft="55dp"
        android:layout_marginTop="3dp"
        android:focusable="false"
        android:text="Date"
        android:textColor="@android:color/holo_green_dark"
        android:textSize="8dp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/memberno"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="50dp"
        android:layout_toRightOf="@id/lblListHeader"
        android:focusable="false"
        android:text="No"
        android:textColor="@android:color/holo_green_dark"
        android:textSize="10dp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/membername"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/memberno"
        android:layout_marginLeft="50dp"
        android:layout_marginTop="3dp"
        android:layout_toRightOf="@id/lblListHeader"
        android:focusable="false"
        android:text="Name:"
        android:textColor="@android:color/holo_green_dark"
        android:textSize="8dp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/groupcountvalue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_alignParentRight="true"
        android:layout_marginRight="50dp"
        android:focusable="false"
        android:text="user"
        android:textColor="@android:color/holo_green_dark"
        android:textSize="10dp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/grouptotalvalue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/memberno"
        android:layout_alignParentEnd="true"
        android:layout_alignParentRight="true"
        android:layout_marginRight="50dp"
        android:text="total"
        android:textColor="@android:color/holo_green_dark"
        android:textSize="10dp"
        android:textStyle="bold" />

    <ImageButton
        android:id="@+id/printdaily"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_alignParentRight="true"
        android:layout_marginTop="5dp"
        android:background="@null"
        android:focusable="false"
        android:src="@drawable/print" />

</RelativeLayout>