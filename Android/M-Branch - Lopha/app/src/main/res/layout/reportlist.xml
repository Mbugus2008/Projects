<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/backgroundactionbar"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/memberno"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Member No"
                android:textColor="@color/brand_ink"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/transtype"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:hint="trans type"
                android:textColor="@color/brand_success"
                android:textSize="11sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/sent"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/sent" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/membername"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Member name"
                android:textColor="@color/brand_muted"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tamount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:hint="total"
                android:textColor="@color/brand_success"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/reference"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Reference no"
                android:textColor="@color/brand_muted"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/receiptno"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Receipt no"
                android:textColor="@color/brand_muted"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>