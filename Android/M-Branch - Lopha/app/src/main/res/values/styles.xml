<resources>
    <!-- Base application theme: brand Material 3 look. -->
    <style name="AppTheme" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/brand_orange</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/brand_orange_soft</item>
        <item name="colorOnPrimaryContainer">@color/brand_orange_dark</item>
        <item name="colorSecondary">@color/brand_ink</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSecondaryContainer">@color/brand_ink_soft</item>
        <item name="colorOnSecondaryContainer">@color/brand_ink</item>
        <item name="colorSurface">@color/brand_surface</item>
        <item name="colorOnSurface">@color/brand_text</item>
        <item name="colorSurfaceVariant">@color/brand_tint</item>
        <item name="colorOnSurfaceVariant">@color/brand_muted</item>
        <item name="colorOutline">@color/brand_outline</item>
        <item name="android:colorBackground">@color/brand_bg</item>
        <item name="android:windowBackground">@color/brand_bg</item>
        <item name="android:statusBarColor">@color/brand_orange_dark</item>
        <item name="android:navigationBarColor">@color/brand_surface</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="buttonStyle">@style/MybuttonTheme</item>
        <item name="materialButtonStyle">@style/AppButton</item>
        <item name="editTextStyle">@style/AppEditText</item>
        <item name="cardViewStyle">@style/MyCardViewStyle</item>
    </style>

    <!-- Modern filled button (MaterialButton) -->
    <style name="AppButton" parent="Widget.Material3.Button">
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:minHeight">52dp</item>
        <item name="cornerRadius">14dp</item>
        <item name="backgroundTint">@color/brand_orange</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <!-- Soft brand button for secondary actions -->
    <style name="AppButton.Tonal" parent="Widget.Material3.Button.TonalButton">
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:minHeight">52dp</item>
        <item name="cornerRadius">14dp</item>
        <item name="backgroundTint">@color/brand_orange_soft</item>
        <item name="android:textColor">@color/brand_orange_dark</item>
        <item name="iconTint">@color/brand_orange_dark</item>
    </style>

    <!-- Outlined button -->
    <style name="AppButton.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:minHeight">52dp</item>
        <item name="cornerRadius">14dp</item>
        <item name="strokeColor">@color/brand_outline</item>
        <item name="android:textColor">@color/brand_ink</item>
    </style>

    <!-- Rounded input box for plain EditTexts across the app -->
    <style name="AppEditText" parent="Widget.AppCompat.EditText">
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/brand_text</item>
        <item name="android:textColorHint">@color/brand_muted</item>
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:minHeight">52dp</item>
    </style>

    <style name="elremFontMedium" parent="@android:style/TextAppearance.Medium">
        <item name="android:textSize">20dp</item>
        <item name="android:textIsSelectable">true</item>
    </style>

    <style name="MyActionBarTheme" parent="@style/Widget.AppCompat.Light.ActionBar">
        <item name="android:background">@drawable/backgroundactionbar</item>
        <item name="background">@drawable/backgroundactionbar</item>
        <item name="android:gravity">center</item>
        <item name="android:layout_gravity">center</item>
    </style>

    <style name="MybuttonTheme" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/bg_button_brand</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">18dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
    <style name="MyCardViewStyle" parent="Widget.MaterialComponents.CardView">
        <!-- Soft elevation, rounded corners -->
        <item name="cardBackgroundColor">@color/brand_surface</item>
        <item name="cardElevation">2dp</item>
        <item name="cardCornerRadius">18dp</item>
        <item name="android:layout_margin">10dp</item>
        <item name="cardPreventCornerOverlap">true</item>
        <item name="cardUseCompatPadding">true</item>
        <item name="cardMaxElevation">4dp</item>

        <!-- Add more attributes as needed -->
    </style>



    <style name="labels" parent="@android:style/Widget.TextView">
        <item name="android:textSize">15dp</item>
        <item name="android:gravity">left|center_vertical</item>
        <item name="android:layout_width">120dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:layout_margin">10dp</item>
        <item name="layout_constraintStart_toStartOf">parent</item>
    </style>
    <style name="input" parent="@android:style/Widget.TextView">
        <item name="android:textSize">15dp</item>
        <item name="android:gravity">center|center_vertical</item>
        <item name="android:layout_width">200dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:layout_margin">10dp</item>

        <item name="layout_constraintEnd_toEndOf">parent</item>
    </style>
</resources>
