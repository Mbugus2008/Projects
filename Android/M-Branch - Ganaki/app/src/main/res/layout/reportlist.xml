<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
   >
    <RelativeLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        >

        <TextView
            android:id="@+id/loan"
            android:layout_width="80dp"
            android:layout_height="wrap_content"

            android:gravity="right"
            android:text="loan"
            android:textSize="10dp" />

        <TextView
            android:id="@+id/welfare"
            android:layout_width="80dp"
            android:gravity="right"
            android:layout_height="wrap_content"
            android:layout_below="@id/loan"

            android:textSize="10dp"
            android:text="welfare" />

        <TextView
            android:id="@+id/shares"
            android:layout_width="100dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="80dp"

            android:gravity="right"
            android:text="shares"
            android:textSize="10dp" />

        <TextView
            android:id="@+id/operation"
            android:layout_width="100dp"
            android:layout_height="wrap_content"
            android:layout_below="@id/shares"
            android:layout_marginLeft="80dp"

            android:gravity="right"

            android:hint="operation"
            android:textSize="10dp" />

        <TextView
            android:id="@+id/stage"
            android:layout_width="100dp"
            android:layout_height="wrap_content"

            android:layout_alignParentRight="true"
            android:layout_marginLeft="20dp"
            android:layout_marginRight="100dp"
            android:gravity="right"
            android:hint="stage"
            android:textSize="10dp" />

        <TextView
            android:id="@+id/court"
            android:layout_width="100dp"
            android:layout_height="wrap_content"
            android:layout_below="@id/stage"
            android:layout_alignParentRight="true"
            android:layout_marginLeft="20dp"
            android:layout_marginRight="100dp"
            android:gravity="right"
            android:hint="Court Bond"

            android:textSize="10dp" />
        <TextView
        android:id="@+id/savings"
            android:layout_width="80dp"
            android:gravity="right"
        android:layout_height="wrap_content"

        android:layout_marginLeft="20dp"
        android:layout_marginRight="10dp"
        android:textSize="10dp"
        android:layout_alignParentRight="true"

        android:hint="Savings" />

        <TextView
            android:id="@+id/amount"
            android:layout_width="80dp"
            android:layout_height="wrap_content"
            android:layout_below="@id/savings"
            android:layout_alignParentRight="true"
            android:layout_marginLeft="20dp"
            android:layout_marginRight="10dp"
            android:gravity="right"
            android:hint="Total"
            android:textColor="@android:color/holo_green_light"
            android:textSize="13dp"
            android:textStyle="bold" />
    </RelativeLayout>
</RelativeLayout>