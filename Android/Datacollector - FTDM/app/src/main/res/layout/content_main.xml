<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/relativeLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:layout_behavior="@string/appbar_scrolling_view_behavior"
    tools:context="com.trimline.ftdm.MainActivity"
    tools:showIn="@layout/activity_main">



        <androidx.cardview.widget.CardView
            android:id="@+id/elevatedCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

          app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:cardCornerRadius="8dp"
            app:cardElevation="10dp"
            app:cardUseCompatPadding="true">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"

                >

                <CheckBox
                    android:id="@+id/scaleconnected"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="false"
                    android:inputType="none"
                    android:text="scale"
                    app:layout_constraintEnd_toStartOf="@id/guideline2"
                    app:layout_constraintHorizontal_bias="0.5"

                    app:layout_constraintTop_toTopOf="parent" />

                <CheckBox
                    android:id="@+id/printerconnected"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="false"
                    android:inputType="none"
                    android:text="printer"
                    app:layout_constraintHorizontal_bias="0.5"

                    app:layout_constraintStart_toEndOf="@id/guideline2"
                    app:layout_constraintTop_toTopOf="parent" />

                <androidx.constraintlayout.widget.Guideline
                    android:id="@+id/guideline2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    app:layout_constraintGuide_percent="0.5" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.cardview.widget.CardView>


    <androidx.cardview.widget.CardView
        android:id="@+id/elevatedCard2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/elevatedCard"
        app:cardCornerRadius="8dp"
        app:cardElevation="10dp"
        app:cardUseCompatPadding="true">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="10dp"
            >

    <TextView
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="@id/farmerno"
        android:id="@+id/textView"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:gravity="center"
        android:text="Farmer Number" />

    <AutoCompleteTextView
        android:id="@+id/farmerno"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toEndOf="@id/textView"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        />


    <TextView
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/farmerno"
        app:layout_constraintEnd_toEndOf="parent"
        android:id="@+id/farmername"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Farmer Name"
        android:gravity="right"
        android:layout_marginBottom="20dp"
        android:textStyle="bold" />

    <ProgressBar
        android:id="@+id/getfarmername"
        android:layout_width="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/farmerno"
        android:layout_height="wrap_content"
        android:text="Farmer Name"
        android:visibility="gone" />


    <TextView
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/farmername"
        app:layout_constraintBottom_toBottomOf="@id/more"
        android:id="@+id/textView2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="KG Collected" />


    <Button
        app:layout_constraintStart_toEndOf="@id/textView2"
        app:layout_constraintTop_toBottomOf="@id/farmername"
        android:id="@+id/clear"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Clear"
        android:textSize="10dp" />

    <Button
        app:layout_constraintStart_toEndOf="@id/clear"
        app:layout_constraintTop_toBottomOf="@id/farmername"
        android:id="@+id/more"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="More"
        android:textSize="10dp" />

    <TextView
        app:layout_constraintStart_toEndOf="@id/more"
        app:layout_constraintTop_toBottomOf="@id/farmername"
        app:layout_constraintBottom_toBottomOf="@id/more"
        android:id="@+id/kg2"
        android:layout_width="50dp"
        android:layout_height="0dp"
        android:gravity="center"
        android:text="0.0" />

    <EditText
        app:layout_constraintStart_toEndOf="@id/kg2"
        app:layout_constraintTop_toBottomOf="@id/farmername"
        app:layout_constraintEnd_toEndOf="parent"
        android:id="@+id/Kg"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:enabled="true"
        android:gravity="end"
        android:inputType="numberDecimal" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>
    <androidx.cardview.widget.CardView
        android:id="@+id/elevatedCard3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/elevatedCard2"
        app:cardCornerRadius="8dp"
        app:cardElevation="10dp"
        app:cardUseCompatPadding="true">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="10dp"
            >
    <View
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:id="@+id/view"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:background="@android:color/holo_green_dark" />

    <TextView
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/view"
        android:id="@+id/textView3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="KG Collected"
        android:textSize="20dp" />

    <TextView
        app:layout_constraintStart_toEndOf="@id/textView3"
        app:layout_constraintTop_toBottomOf="@id/view"
        app:layout_constraintEnd_toEndOf="parent"
        android:id="@+id/Kgcollected"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="0.0"
        android:textAlignment="textEnd"
        android:textSize="20dp" />

    <View
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/Kgcollected"
        android:id="@+id/view2"
        android:layout_width="wrap_content"
        android:layout_height="2dp"
        android:background="@android:color/holo_green_dark" />
        </androidx.constraintlayout.widget.ConstraintLayout></androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>
