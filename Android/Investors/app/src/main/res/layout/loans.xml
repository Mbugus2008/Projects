<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="MissingConstraints" >
    <data class="Loansbinding" >
        <variable
            name="l"
            type="com.trimline.investors.Loans" />
        <import type="android.text.Html"/>
    </data>
<androidx.constraintlayout.widget.ConstraintLayout
    android:background="@drawable/border"
  android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:id="@+id/product"
        android:hint="Product"
        android:text="@={l.Credit_Type}"
        />
    <TextView
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:id="@+id/Productid"
        android:hint="Loan No"
        android:text="@={l.Credit_Number}"
        app:layout_constraintTop_toBottomOf="@id/product"
        />
    <TextView
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:id="@+id/FleetNo"
        android:hint="Fleet No"
        android:text="@={l.Fleet_No}"
        app:layout_constraintTop_toBottomOf="@id/Productid"
        />
    <TextView
       style="@style/currency"
        android:id="@+id/paidtoday"
        app:layout_constraintEnd_toStartOf="@id/Balance"
        android:hint="paid today"
        android:text="@{Html.fromHtml(l != null?  @string/curr(l.Paid_Today) : `Paid Today`)}"
        />
    <TextView
        android:id="@+id/Approved"
        style="@style/currency"
        android:hint="Loan Amount"
        android:text="@{Html.fromHtml(l != null ? @string/curr(l.Credit_Approved_Amount ):`Loan Amount`)}"
        app:layout_constraintEnd_toEndOf="parent" />
    <TextView
        android:id="@+id/Paid"
        style="@style/currency"
        android:hint="Paid"
        android:text="@{Html.fromHtml(l != null ? @string/curr(l.Credit_Approved_Amount - (l.Credit_Balance + l.Interest_Balance) ):`Paid`)}"
        app:layout_constraintTop_toBottomOf="@id/Approved"
        app:layout_constraintEnd_toEndOf="parent" />
    <TextView
        android:id="@+id/Balance"
        style="@style/currency"
        android:hint="Balance"
        android:text="@{Html.fromHtml(l != null ? @string/curr(l.Credit_Balance + l.Interest_Balance ):`Balance`)}"
        app:layout_constraintTop_toBottomOf="@id/Paid"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
</layout>