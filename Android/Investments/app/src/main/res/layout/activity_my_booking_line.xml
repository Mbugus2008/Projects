<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:context=".My_booking"
    >
    <data class="Mybooking">
        <variable
            name="booking"
            type="com.trimline.investments.Property_sales" />
    </data>
<androidx.constraintlayout.widget.ConstraintLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/layoutborder"
    >
    <TextView
        android:layout_width="100dp"
        android:layout_height="wrap_content"
        android:hint="Booking no"
        android:text="@={booking.Transaction_No}"
        android:id="@+id/bookingid"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        />
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:hint="Created on"
        android:date="@{booking.Created_On}"
        android:id="@+id/Createdon"
        app:layout_constraintTop_toBottomOf="@id/bookingid"
        app:layout_constraintStart_toStartOf="parent"/>
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:hint="Investment account"
        android:text="@={booking.Investment_Account}"
        android:id="@+id/Investmentaccount"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toEndOf="@id/bookingid"
        />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:hint="savingsaccount"
        android:text="@={booking.Savings_Account}"
        android:id="@+id/savingaccont"
        app:layout_constraintTop_toBottomOf="@id/Investmentaccount"
        app:layout_constraintStart_toEndOf="@id/bookingid"
        />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:hint="project Name"
        android:text="@={booking.Project_Name}"
        android:id="@+id/project"
android:textSize="10dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        />
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:hint="Unit Name"
        android:text="@={booking.Asset_Name}"
        android:id="@+id/Asset"
        android:textSize="7dp"
        app:layout_constraintTop_toBottomOf="@id/project"
        app:layout_constraintEnd_toEndOf="parent"
        />
</androidx.constraintlayout.widget.ConstraintLayout>
</layout>