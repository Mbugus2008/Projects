<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="1dp"
    android:background="@drawable/layoutborder"
    >
    <TextView
        android:id="@+id/name"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fontFamily="@font/trocchi"
        android:gravity="center|left"
android:visibility="gone"
        android:textSize="20dp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@id/book"
        app:layout_constraintTop_toTopOf="parent" />
    <TextView
        android:id="@+id/desc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/andika"
        android:hint="Description"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent" />
    <ProgressBar
        android:id="@+id/size"
        android:layout_width="0dp"
        android:layout_height="30dp"
        android:gravity="left"
        style="?android:attr/progressBarStyleHorizontal"
        android:hint="Size"
        android:textSize="17dp"
        android:maxHeight="30dp"
        android:minHeight="30dp"
       app:layout_constraintStart_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/desc"
        app:layout_constraintEnd_toStartOf="@id/book"

        app:layout_constraintStart_toStartOf="parent"/>
    <TextView
        android:id="@+id/progrespercent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
       app:layout_constraintTop_toTopOf="@id/size"
        app:layout_constraintBottom_toBottomOf="@id/size"
        android:text="Percentage"
        app:layout_constraintStart_toEndOf="@id/size"

        android:textSize="15sp" />
    <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="left"
        android:fontFamily="@font/trocchi"
        android:id="@+id/price"
        android:hint="Price"
        android:textSize="13dp"
        app:layout_constraintTop_toBottomOf="@id/size"
        app:layout_constraintEnd_toStartOf="@id/book"
        />

    <Button
        android:id="@+id/book"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="@id/price"
        app:layout_constraintEnd_toEndOf="parent"
        android:text="More Details ..."
        android:textSize="10sp"

        />
</androidx.constraintlayout.widget.ConstraintLayout>