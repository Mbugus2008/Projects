<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">
    <data class="Contactitem">

        <variable
            name="contacts"
            type="com.trimline.investments.Contact" />
    </data>
<androidx.constraintlayout.widget.ConstraintLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="30dp"

    tools:context=".Register">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintLeft_toLeftOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintLeft_toLeftOf="parent">
           <RadioGroup
               android:layout_width="wrap_content"
               android:layout_height="wrap_content"
               android:id="@+id/type"
               android:orientation="horizontal"
               >
               <RadioButton
               android:layout_width="wrap_content"
               android:layout_height="wrap_content"
                   android:checked="true"
                   android:id="@+id/member"
               android:text="Member">
           </RadioButton>
               <RadioButton
                   android:layout_width="wrap_content"
                   android:layout_height="wrap_content"
                   android:id="@+id/nonmember"
                   android:text="Non Member">
               </RadioButton>
           </RadioGroup>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintLeft_toLeftOf="parent">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ID No/Passport No"
                android:layout_weight="0.4"
                >
            </TextView>
            <EditText
                style="@style/registertext"
                android:hint="12345678"
                android:id="@+id/Identity_No"
                android:text="@={contacts.National_ID_No}"
                >
            </EditText>

        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:id="@+id/nonmemberlayout"

            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintLeft_toLeftOf="parent">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="First Name"
                    android:id="@+id/firstname"
                    android:layout_weight="0.4"
                    >
                </TextView>
                <EditText
                    style="@style/registertext"
                    android:layout_height="wrap_content"
                    android:hint="First Name"
                    android:text="@={contacts.First_Name}"
                    android:id="@+id/Name"
                    >
                </EditText>
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintLeft_toLeftOf="parent">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Last Name"
                    android:id="@+id/lastname"
                    android:layout_weight="0.4"
                    >
                </TextView>
                <EditText
                    style="@style/registertext"
                    android:layout_height="wrap_content"
                    android:hint="Last Name"
                    android:text="@={contacts.Last_Name}"
                    android:id="@+id/lastName"
                    >
                </EditText>
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintLeft_toLeftOf="parent">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Phone no"
                    android:layout_weight="0.4"
                    >
                </TextView>
                <EditText
                    style="@style/registertext"
                    android:layout_height="wrap_content"
                    android:hint="+2540000000"
                    android:id="@+id/Phone_No"
                    android:text="@={contacts.Mobile_Phone_No}"

                    >
                </EditText>
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintLeft_toLeftOf="parent">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Occupation"
                    android:layout_weight="0.4"
                    >
                </TextView>
                <EditText
                    style="@style/registertext"
                    android:hint="Doctor,lawyer"
                    android:id="@+id/Company_Name"
                    android:text="@={contacts.Occupation}"
                    >
                </EditText>
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintLeft_toLeftOf="parent">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="KRA Pin"
                    android:layout_weight="0.4"
                    >
                </TextView>
                <EditText
                    style="@style/registertext"
                    android:hint="ADFE4567F"
                    android:id="@+id/Pin"

                    android:text="@={contacts.Passport_No}"
                    >
                </EditText>
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintLeft_toLeftOf="parent">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Email"
                    android:layout_weight="0.4"
                    >
                </TextView>
                <EditText
                    style="@style/registertext"
                    android:hint="name@email.com"
                    android:id="@+id/E_Mail"
                    android:inputType="textEmailAddress"
                    android:text="@={contacts.E_Mail_Address}"
                    >
                </EditText>
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintLeft_toLeftOf="parent">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Password"
                    android:layout_weight="0.4"
                    >
                </TextView>
                <EditText
                    style="@style/registertext"
                    android:hint="12345"
                    android:inputType="textPassword"
                    android:id="@+id/Pass"
                    android:text="@={contacts.Pass}"
                    >
                </EditText>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintLeft_toLeftOf="parent">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Confirm Pass"
                    android:layout_weight="0.4"
                    >
                </TextView>
                <EditText
                    style="@style/registertext"
                    android:hint="12345"
                    android:inputType="textPassword"
                    android:id="@+id/confirmpassword"
                    android:text="@={contacts.Confirm_Pass}"
                    >
                </EditText>

            </LinearLayout>
        </LinearLayout>
        <Button
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="Register"
            android:id="@+id/register"
            android:background="@drawable/spinner"
            >
        </Button>
    </LinearLayout>



</androidx.constraintlayout.widget.ConstraintLayout></layout>