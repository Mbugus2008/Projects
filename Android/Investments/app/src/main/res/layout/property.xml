<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:map="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Home">

    <RadioGroup
        android:layout_width="match_parent"
        android:layout_height="50dp"
        map:layout_constraintTop_toTopOf="parent"
        map:layout_constraintStart_toStartOf="parent"
        android:orientation="horizontal"
        android:weightSum="1"

        android:id="@+id/availability"
        >
        <RadioButton
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_gravity="start"
            android:checked="true"
            android:id="@+id/All"
            android:textStyle="bold"
            android:layout_weight="0.33"
            style="@style/MyRadioButtonStyle"
            android:text="ALL PROPERTIES"/>
        <RadioButton
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:id="@+id/Current"
            android:button="@null"
            android:layout_weight="0.33"
            android:textStyle="bold"
            style="@style/MyRadioButtonStyle"
            android:text="CURRENT PROPERTIES"/>
        <RadioButton
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:id="@+id/Past"
            android:button="@null"
            android:layout_weight="0.33"
            android:textStyle="bold"
            style="@style/MyRadioButtonStyle"
            android:text="PREVIOUS PROPERTIES"/>
    </RadioGroup>

    <RelativeLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="50dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/layoutborder"
        map:layout_constraintLeft_toLeftOf="parent"
        android:id="@+id/findlayout"
        android:visibility="gone"
        map:layout_constraintTop_toTopOf="parent"
        >

        <Button
            android:id="@+id/Search"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/location"
            android:layout_centerHorizontal="true"
            android:background="@drawable/spinner"
            android:gravity="center"
            android:textSize="10sp"
            android:visibility="gone"
            android:text="Search">
        </Button>

        <Spinner
            android:id="@+id/location"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/findhome"
            android:layout_marginLeft="30dp"

            android:layout_toRightOf="@id/property"
            android:background="@drawable/spinner"

            />


        <Spinner
            android:id="@+id/property"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/forsale"


            android:background="@drawable/spinner"
            />

        <Spinner
            android:id="@+id/forsale"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/findhome"

            android:background="@drawable/spinner"
            android:dropDownSelector="@drawable/spinner"

            />

        <TextView
            android:id="@+id/findhome"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="5dp"
            android:layout_centerHorizontal="true"
            android:text="Find your home"
            android:textColor="@color/quantum_googgreen"
            android:textSize="30sp">

        </TextView>

    </RelativeLayout>


    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        map:layout_constraintGuide_percent="0.34" />


    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/properties"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:visibility="gone"
        android:layoutMode="clipBounds"
        android:scrollbars="vertical|horizontal"
        map:layout_constraintBottom_toBottomOf="parent"
        map:layout_constraintTop_toBottomOf="@id/availability"
        map:layout_constraintVertical_bias="0.0"
        tools:layout_editor_absoluteX="0dp">

    </androidx.recyclerview.widget.RecyclerView>

    <ExpandableListView
        android:id="@+id/propertylist"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        map:layout_constraintTop_toBottomOf="@id/availability"
        map:layout_constraintBottom_toBottomOf="parent"></ExpandableListView>

</androidx.constraintlayout.widget.ConstraintLayout>