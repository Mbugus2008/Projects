<resources>
    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.MaterialComponents.Light.NoActionBar">
        <!-- Customize your theme here. -->
<!--                <item name="colorPrimary">@color/colorPrimary</item>-->
<!--                <item name="colorPrimaryDark">@color/colorPrimaryDark</item>-->
<!--                <item name="colorAccent">@color/colorAccent</item>-->
        <item name="android:windowBackground">@drawable/backgroundposted</item>
        <item name="android:spinnerStyle">@style/spinner</item>
        <item name="android:spinnerDropDownItemStyle">@style/spinnerdropdown</item>

    </style>

    <style name="MyRadioButtonStyle" parent="@android:style/Widget.CompoundButton.RadioButton">
        <item name="android:button">@drawable/selector</item>
        <item name="android:background">@drawable/selector</item>
        <item name="android:textSize">10dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/quantum_black_100</item>
    </style>

    <style name="Button" parent="android:Widget.Button">
        <item name="background">@drawable/backgroundposted</item>
        <item name="android:textColor">@color/quantum_black_100</item>
    </style>

    <style name="spinner" parent="android:Widget.Spinner">
        <item name="android:background">@drawable/bg_spinner</item>
        <!--<item name="android:textColorHint">#F98916</item>-->
    </style>

    <style name="spinnerdropdown" parent="android:Widget.Spinner.DropDown">
        <item name="android:background">@drawable/backgroundposted</item>
        <!--<item name="android:textColorHint">#F98916</item>-->
    </style>

    <style name="edittext" parent="android:Widget.EditText">
        <item name="android:textColor">@color/quantum_white_100</item>
        <item name="android:textColorHint">#F98916</item>
    </style>

    <style name="registertext">
        <item name="android:layout_width">250dp</item>
        <item name="android:layout_height">wrap_content</item>
    </style>

    <style name="AppTheme.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="floattextviews" parent="@android:style/Widget.TextView">
        <item name="android:textSize">15dp</item>
        <item name="android:singleLine">true</item>
        <item name="android:gravity">left|center_vertical</item>
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="layout_constraintEnd_toStartOf">@id/guideline2</item>
        <item name="layout_constraintStart_toStartOf">parent</item>
    </style>

    <style name="floattextedits" parent="@android:style/Widget.TextView">
        <item name="android:textSize">15dp</item>
        <item name="android:singleLine">true</item>
        <item name="android:gravity">center</item>
        <item name="android:layout_width">0dp</item>
        <item name="android:background">@drawable/layoutborder</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:dropDownWidth">200dp</item>
        <item name="android:selectAllOnFocus">true</item>
        <item name="layout_constraintEnd_toEndOf">parent</item>
        <item name="layout_constraintStart_toStartOf">@id/guideline2</item>
    </style>

    <style name="floatspinner" parent="@android:style/Widget.TextView">
        <item name="android:textSize">15dp</item>
        <item name="android:singleLine">true</item>
        <item name="android:gravity">center</item>
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:dropDownWidth">200dp</item>
        <item name="android:selectAllOnFocus">true</item>
        <item name="layout_constraintEnd_toEndOf">parent</item>
        <item name="layout_constraintStart_toStartOf">@id/guideline2</item>
    </style>

    <style name="ToolbarSubtitleAppearance" parent="@style/TextAppearance.Widget.AppCompat.Toolbar.Subtitle">
        <item name="android:textSize">14dp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="realestatefund" parent="@android:style/Widget.TextView">
        <item name="android:textSize">15dp</item>
        <item name="android:singleLine">true</item>
        <item name="android:gravity">left|center</item>
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">30dp</item>
        <item name="android:layout_marginTop">15dp</item>
        <item name="android:layout_marginBottom">15dp</item>
        <item name="layout_constraintEnd_toEndOf">@id/guideline3</item>
        <item name="layout_constraintStart_toStartOf">parent</item>
    </style>

    <style name="realestatefundx" parent="@android:style/Widget.TextView">
        <item name="android:textSize">15dp</item>
        <item name="android:singleLine">true</item>
        <item name="android:gravity">left|center</item>
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">30dp</item>
        <item name="android:layout_marginTop">15dp</item>
        <item name="android:layout_marginBottom">15dp</item>
        <item name="layout_constraintEnd_toEndOf">parent</item>
        <item name="layout_constraintStart_toStartOf">@id/guideline3</item>
    </style>

    <style name="AppTheme.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar" />

    <style name="AppTheme.PopupOverlay" parent="ThemeOverlay.AppCompat.Light" />


</resources>