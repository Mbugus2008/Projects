@using System.Text.Json
@model Matatu_Dashboard.Models.DashboardSectionViewModel
@{
    Layout = null;
    var selectedRange = (ViewData["SelectedRange"] as string) ?? "today";
    var todayStr = DateTime.Today.ToString("yyyy-MM-dd");
    var yesterdayStr = DateTime.Today.AddDays(-1).ToString("yyyy-MM-dd");
    // Show selected date in the date picker (only for specific date ranges)
    var initialDate = DateTime.TryParseExact(selectedRange, "yyyy-MM-dd", null,
        System.Globalization.DateTimeStyles.None, out var parsedDate)
        ? parsedDate.ToString("yyyy-MM-dd")
        : todayStr;
    var pathBase = Context.Request.PathBase.HasValue ? Context.Request.PathBase.Value! : string.Empty;
    var summaryBasePath = string.IsNullOrWhiteSpace(pathBase) ? "/fuelsummary" : $"{pathBase}/fuelsummary";
    var retrievedAt = (DateTime?)ViewData["RetrievedAt"] ?? DateTime.Now;
    var summary = ViewData["Summary"] as Matatu_Dashboard.Models.DashboardSectionViewModel;
    var summaryRows = summary?.Rows ?? new();
    var summaryCols = summary?.Columns ?? new();
    var depotRows = Model.Rows;
    var depotCols = Model.Columns;

    // Metrics from DisFuelSummary (aggregated)
    var metricKeys = new[] { "Total_Collection", "Total_Vehicles", "Total_Fuel_ltrs",
        "Total_Fuels_Amount", "Total_Paid", "Total_Mileage", "Total_Fuel_Arrears", "Net_Offload" };
    var availableMetrics = metricKeys.Where(k => summaryCols.Contains(k, StringComparer.OrdinalIgnoreCase)).ToList();

    var activeVehicles = summaryRows.Sum(r => r.TryGetValue("Active_Vehicles", out var av) && int.TryParse(av, out var avi) ? avi : 0);
    var totalVehicles = summaryRows.Sum(r => r.TryGetValue("Total_Vehicles", out var tv) && int.TryParse(tv, out var tvi) ? tvi : 0);

    // DisFuelSummary has no management figure, so total it from the depot rows.
    var hasManagement = depotCols.Contains("Management", StringComparer.OrdinalIgnoreCase);
    var totalManagement = depotRows.Sum(r =>
        r.TryGetValue("Management", out var mgmt) && decimal.TryParse(mgmt, out var mgmtVal) ? mgmtVal : 0m);

    // Build the top strip up front so the management total can sit beside the
    // collection total no matter what order BC returns its columns in.
    var metricTiles = new List<(string Label, string Value, string Css)>();
    foreach (var key in availableMetrics)
    {
        var isInt = key == "Total_Vehicles";
        var label = isInt ? "Vehicles (Active/Total)" : key.Replace("_", " ");
        decimal val = isInt
            ? summaryRows.Sum(r => r.TryGetValue(key, out var v) && int.TryParse(v, out var i) ? i : 0)
            : summaryRows.Sum(r => r.TryGetValue(key, out var v) && decimal.TryParse(v, out var d) ? d : 0);
        var css = key == "Total_Fuel_Arrears" && val > 0 ? "red" : key == "Total_Collection" ? "blue" : "";
        metricTiles.Add((label, isInt ? $"{activeVehicles}/{totalVehicles}" : val.ToString("N2"), css));

        if (key == "Total_Collection" && hasManagement)
        {
            metricTiles.Add(("Total Management", totalManagement.ToString("N2"), ""));
        }
    }

    // Depot columns in display order (OData field names)
    // "Capacity" carries the BC vehicle type code - labelled "Vehicle Type" below.
    var depotFocusCols = new[] { "Date", "Vehicle", "Fleet", "Capacity", "Crew",
        "Total_Collection", "Management_Target", "Fuel", "Total_Litres", "Km_Litre", "Amount_Paid", "Balance", "Millage", "Net_Offload", "Comments" }
        .Where(c => c == "Crew" || depotCols.Contains(c, StringComparer.OrdinalIgnoreCase)).ToList();

    // Friendly labels for columns
    var depotColLabels = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase) {
        {"Date", "Date"}, {"Vehicle", "Vehicle"}, {"Fleet", "Fleet"},
        {"Capacity", "Vehicle Type"},
        {"Crew", "Crew"},
        {"Total_Collection", "Total Collection"}, {"Management_Target", "Management Target"},
        {"Fuel", "Fuel"}, {"Total_Litres", "Litres"}, {"Km_Litre", "Km/Litre"},
        {"Amount_Paid", "Fuel Paid"},
        {"Balance", "Unpaid Fuel"}, {"Millage", "Mileage"}, {"Net_Offload", "Net Offload"},
        {"Comments", "Comments"}
    };

    // Monetary columns to format with N2 and right-align
    var moneyCols = new HashSet<string>(StringComparer.OrdinalIgnoreCase) {
        "Total_Collection", "Management_Target", "Fuel", "Total_Litres", "Km_Litre", "Amount_Paid", "Balance", "Net_Offload"
    };

    // Columns that should wrap text instead of truncating on one line
    var wrapCols = new HashSet<string>(StringComparer.OrdinalIgnoreCase) { "Comments" };

    // Order by fleet no - numeric ascending, with blank / non-numeric fleets last.
    // (Fleet comes from OData as text, so '99' would otherwise sort after '100'.)
    var orderedDepotRows = depotRows
        .OrderBy(r =>
        {
            var text = (r.TryGetValue("Fleet", out var f) ? (f ?? string.Empty) : string.Empty).Trim();
            return int.TryParse(text, out var fleetNo) ? fleetNo : int.MaxValue;
        })
        .ThenBy(r => r.TryGetValue("Fleet", out var f2) ? (f2 ?? string.Empty) : string.Empty, StringComparer.OrdinalIgnoreCase)
        .ThenBy(r => r.TryGetValue("Vehicle", out var v2) ? (v2 ?? string.Empty) : string.Empty, StringComparer.OrdinalIgnoreCase)
        .ToList();
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"]</title>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;700&display=swap" rel="stylesheet">
    <style>
        :root { color-scheme: light; }
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: 'DM Sans', sans-serif; background: #f4f6f9; color: #1a1a2e; padding: 16px; }
        .header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; flex-wrap: wrap; gap: 8px; }
        .header h1 { font-size: 20px; font-weight: 700; }
        .tabs { display: flex; gap: 4px; flex-wrap: wrap; }
        .tabs a { padding: 6px 14px; border-radius: 6px; text-decoration: none; font-size: 13px; font-weight: 500; color: #555; background: #e8ecf1; }
        .tabs a.active { background: #006B3F; color: #fff; }
        .metrics { display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 10px; margin-bottom: 16px; }
        .metric-card { background: #fff; border-radius: 10px; padding: 14px; box-shadow: 0 1px 3px rgba(0,0,0,.08); text-align: center; }
        .metric-card .label { font-size: 11px; color: #888; text-transform: uppercase; letter-spacing: .5px; }
        .metric-card .value { font-size: 22px; font-weight: 700; color: #006B3F; margin-top: 4px; }
        .metric-card .value.red { color: #d32f2f; }
        .metric-card .value.blue { color: #1565c0; }
        table { width: 100%; border-collapse: collapse; background: #fff; border-radius: 10px; overflow: hidden; box-shadow: 0 1px 3px rgba(0,0,0,.08); }
        th { background: #006B3F; color: #fff; padding: 10px 8px; font-size: 12px; text-align: left; white-space: nowrap; }
        td { padding: 8px; font-size: 13px; border-bottom: 1px solid #eee; white-space: nowrap; }
        tr:last-child td { border-bottom: none; }
        .footer { margin-top: 12px; font-size: 11px; color: #999; text-align: center; }
        .table-wrap { width: 100%; overflow-x: auto; -webkit-overflow-scrolling: touch; }
        .table-wrap table { min-width: 900px; }
        @@media (max-width: 640px) {
            body { padding: 10px; }
            .header { flex-direction: column; align-items: flex-start; }
            .header h1 { font-size: 17px; }
            .tabs a { padding: 5px 10px; font-size: 12px; }
            .metrics { grid-template-columns: repeat(2, 1fr); gap: 8px; }
            .metric-card { padding: 10px; }
            .metric-card .value { font-size: 18px; }
            .metric-card .label { font-size: 10px; }
        }
    </style>
</head>
<body>
    <div class="header">
        <h1>@ViewData["Title"]</h1>
        <div class="tabs">
            <a href="@summaryBasePath/today" class="@(selectedRange == "today" || selectedRange == todayStr ? "active" : "")">Today</a>
            <a href="@summaryBasePath/yesterday" class="@(selectedRange == "yesterday" || selectedRange == yesterdayStr ? "active" : "")">Yesterday</a>
            <a href="@summaryBasePath/week" class="@(selectedRange == "week" ? "active" : "")">Week</a>
            <a href="@summaryBasePath/month" class="@(selectedRange == "month" ? "active" : "")">Month</a>
        </div>
    </div>

    <div class="controls" style="display:flex;gap:8px;margin-bottom:12px;flex-wrap:wrap;">
        <input type="date" id="dateFilter" value="@initialDate"
               style="padding:8px;border:1px solid #ccc;border-radius:6px;font-family:inherit;"
               onchange="if(this.value){window.location.href='@summaryBasePath/'+this.value;}" />
        <input type="text" id="vehicleFilter" placeholder="Search vehicle, fleet, type or crew"
               style="padding:8px;border:1px solid #ccc;border-radius:6px;font-family:inherit;flex:1;min-width:160px;"
               oninput="filterVehicles()" onkeyup="filterVehicles()" />
    </div>

    <script>
        function filterVehicles() {
            var q = document.getElementById('vehicleFilter').value.toUpperCase();
            var table = document.getElementById('depotTable');
            if (!table || !table.tBodies.length) return;
            // Resolve columns by header text so adding/removing a column cannot
            // silently break the search (it used to hard-code cells 1/2/3).
            var headers = Array.prototype.map.call(table.tHead.rows[0].cells, function (th) {
                return th.textContent.trim().toUpperCase();
            });
            var searchCols = ['VEHICLE', 'FLEET', 'CREW', 'VEHICLE TYPE'];
            var indexes = searchCols.map(function (name) { return headers.indexOf(name); })
                                    .filter(function (i) { return i >= 0; });
            var rows = table.tBodies[0].rows;
            for (var r = 0; r < rows.length; r++) {
                var text = indexes.map(function (i) {
                    return rows[r].cells[i] ? rows[r].cells[i].textContent : '';
                }).join(' ').toUpperCase();
                rows[r].style.display = (!q || text.indexOf(q) >= 0) ? '' : 'none';
            }
        }
    </script>

    <div class="metrics">
        @foreach (var tile in metricTiles)
        {
            <div class="metric-card">
                <div class="label">@tile.Label</div>
                <div class="value @tile.Css">@tile.Value</div>
            </div>
        }
    </div>

    <div class="table-wrap">
    <table id="depotTable">
        <thead>
            <tr>
                @foreach (var col in depotFocusCols)
                {
                    <th style="@(moneyCols.Contains(col) ? "text-align:right;" : "")">@(depotColLabels.TryGetValue(col, out var label) ? label : col.Replace("_", " "))</th>
                }
            </tr>
        </thead>
        <tbody>
            @foreach (var row in orderedDepotRows)
            {
                <tr>
                    @foreach (var col in depotFocusCols)
                    {
                        if (col == "Crew")
                        {
                            // Show the crew's member no alongside the name, number first
                            // (same order the mobile app uses: [A169] CHARLES MWENJE OREDI).
                            var driverNo = row.TryGetValue("Driver", out var dno) ? dno : string.Empty;
                            var conductorNo = row.TryGetValue("Conductor", out var cno) ? cno : string.Empty;
                            var driver = row.TryGetValue("Driver_Name", out var dv) ? dv : "-";
                            var conductor = row.TryGetValue("Conductor_Name", out var cv) ? cv : "-";
                            <td>
                                <div>
                                    @if (!string.IsNullOrWhiteSpace(driverNo))
                                    {
                                        <b>@driverNo</b>
                                    }
                                    @driver
                                </div>
                                <div style="color:#666;">
                                    @if (!string.IsNullOrWhiteSpace(conductorNo))
                                    {
                                        <b>@conductorNo</b>
                                    }
                                    @conductor
                                </div>
                            </td>
                            continue;
                        }
                        if (col == "Capacity")
                        {
                            // BC vehicle type code -> friendly label ("51 Seater")
                            var cap = row.TryGetValue("Capacity", out var capv) ? capv : string.Empty;
                            <td>@Matatu_Dashboard.Models.VehicleTypeLabels.Describe(cap)</td>
                            continue;
                        }
                        var val = row.TryGetValue(col, out var v) ? v : "-";
                        decimal? numVal = null;
                        if (col == "Date" && val != "-")
                        {
                            val = val.Length > 11 ? val.Substring(0, 11).Trim() : val;
                        }
                        else if (moneyCols.Contains(col) && val != "-" && decimal.TryParse(val, out var parsed))
                        {
                            numVal = parsed;
                            val = parsed.ToString("N2");
                        }
                        var cellStyle = moneyCols.Contains(col) ? "text-align:right;" : "";
                        if (col == "Balance" && numVal is > 0)
                        {
                            cellStyle += "color:#d32f2f;font-weight:600;";
                        }
                        if (col == "Total_Collection")
                        {
                            cellStyle += "font-weight:700;";
                        }
                        if (col == "Net_Offload" && numVal is > 0)
                        {
                            cellStyle += "color:#2e7d32;font-weight:700;";
                        }
                        if (wrapCols.Contains(col))
                        {
                            cellStyle += "white-space:normal;word-break:break-word;min-width:150px;";
                        }
                        <td style="@cellStyle">@val</td>
                    }
                </tr>
            }
        </tbody>
    </table>
    </div>

    @if (orderedDepotRows.Count == 0)
    {
        <p style="text-align:center;color:#999;margin-top:40px;">No depot data for this period.</p>
    }

    <div class="footer">
        @orderedDepotRows.Count depot records · Retrieved @retrievedAt.ToString("HH:mm:ss") · @selectedRange
    </div>
</body>
</html>
