@using System.Text.Json
@model Matatu_Dashboard.Models.BusinessCentralDashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<section class="dashboard-page container-fluid px-0">
    <div class="dashboard-header card border-0 shadow-sm mb-4">
        <div class="card-body d-flex flex-column flex-lg-row justify-content-between align-items-lg-start gap-3">
            <div>
                <div class="dashboard-kicker">Operations Overview</div>
                <h1 class="dashboard-title">Matatu Business Central Dashboard</h1>
                <p class="dashboard-subtitle">Transactions and depot fuel data from Business Central OData.</p>
            </div>
            <div class="d-flex flex-column flex-lg-row gap-3 align-items-lg-center">
                <div class="btn-group date-filter-group" role="group" aria-label="Date filter">
                    <a asp-action="Index" asp-route-range="today" class="btn @(Model.SelectedRange == "today" ? "btn-primary" : "btn-outline-primary")">Today</a>
                    <a asp-action="Index" asp-route-range="yesterday" class="btn @(Model.SelectedRange == "yesterday" ? "btn-primary" : "btn-outline-primary")">Yesterday</a>
                    <a asp-action="Index" asp-route-range="week" class="btn @(Model.SelectedRange == "week" ? "btn-primary" : "btn-outline-primary")">Week</a>
                    <a asp-action="Index" asp-route-range="month" class="btn @(Model.SelectedRange == "month" ? "btn-primary" : "btn-outline-primary")">Month</a>
                </div>
                <div class="dashboard-header-chip rounded-pill px-3 py-2">
                    <span class="header-chip-label">Updated</span>
                    <span class="dashboard-updated">@Model.RetrievedAt.ToString("dd MMM yyyy HH:mm")</span>
                </div>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="alert alert-danger">@Model.ErrorMessage</div>
    }

    @foreach (var dashboardSection in Model.Sections)
    {
        <section class="dashboard-section card border-0 shadow-sm mb-4">
            <div class="card-body">
            <div class="dashboard-section-header d-flex flex-column flex-lg-row justify-content-between align-items-lg-start gap-3">
                <div>
                    <div class="dashboard-section-kicker">Sneat-style section</div>
                    <h2 class="h4 mb-1">@dashboardSection.Title</h2>
                    <div class="dashboard-source">@dashboardSection.ServiceUrl</div>
                    @if (!string.IsNullOrWhiteSpace(dashboardSection.FilterDescription))
                    {
                        <div class="dashboard-filter">@dashboardSection.FilterDescription</div>
                    }
                </div>
                <span class="dashboard-badge badge rounded-pill text-bg-primary px-3 py-2">@dashboardSection.TotalRecords record(s)</span>
            </div>

            @if (!string.IsNullOrWhiteSpace(dashboardSection.ErrorMessage))
            {
                <div class="alert alert-warning mt-3 mb-0">@dashboardSection.ErrorMessage</div>
            }
            else
            {
                <div class="row g-3 mt-1 mb-3">
                    @for (var i = 0; i < dashboardSection.Metrics.Count; i++)
                    {
                        var metric = dashboardSection.Metrics[i];
                        <div class="col-md-3 col-sm-6">
                            <div class="metric-card metric-tone-@(i % 4) card border-0 shadow-sm h-100">
                                <div class="card-body">
                                <div class="metric-card-top d-flex justify-content-between align-items-start gap-3">
                                    <div class="metric-label">@metric.Label</div>
                                    <span class="metric-icon">@metric.Label.Substring(0, 1)</span>
                                </div>
                                <div class="metric-value">@metric.Value</div>
                                <div class="metric-footnote">Live summary from Business Central</div>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                @if (dashboardSection.Highlights.Count > 0)
                {
                    <div class="row g-3 mb-4">
                        @foreach (var highlight in dashboardSection.Highlights)
                        {
                            <div class="col-lg-4 col-sm-6">
                                <div class="highlight-card card border-0 shadow-sm h-100">
                                    <div class="card-body">
                                    <div class="chart-kicker">@highlight.Label amount</div>
                                    <h3 class="h6 mb-1">@highlight.Title</h3>
                                    <div class="highlight-value">@highlight.Value</div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
                @if (dashboardSection.Charts.Count > 0)
                {
                    <div class="row g-3 mb-4">
                        @foreach (var chart in dashboardSection.Charts)
                        {
                            <div class="col-lg-6">
                                <div class="chart-card card border-0 shadow-sm h-100">
                                    <div class="card-body">
                                    <div class="chart-card-header d-flex justify-content-between align-items-start gap-3">
                                        <div>
                                            <div class="chart-kicker">Distribution</div>
                                            <h3 class="h6 mb-0">@chart.Title</h3>
                                        </div>
                                        <span class="chart-badge badge rounded-pill bg-light text-dark border">@(chart.Type == "bar" ? "Bar" : chart.Type == "line" ? "Line" : "Donut")</span>
                                    </div>
                                    <div class="chart-wrapper">
                                        <div id="@chart.Id" class="dashboard-chart h-100"></div>
                                    </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }

            @if (dashboardSection.Columns.Count == 0)
                {
                    <div class="alert alert-light border">No data returned.</div>
                }
            }
            </div>
        </section>
    }
</section>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/apexcharts"></script>
    <script>
        (() => {
            const palette = ["#0d6efd", "#20c997", "#ffc107", "#dc3545", "#6f42c1", "#fd7e14"];
            const charts = @Html.Raw(JsonSerializer.Serialize(
                Model.Sections.SelectMany(section => section.Charts).ToList()));

            charts.forEach(chart => {
                const container = document.getElementById(chart.Id);
                if (!container) {
                    return;
                }

                const colors = chart.Labels.map((_, index) => palette[index % palette.length]);
                const commonOptions = {
                    chart: {
                        fontFamily: 'inherit',
                        toolbar: { show: false },
                        animations: { easing: 'easeinout', speed: 450 }
                    },
                    colors,
                    dataLabels: { enabled: false },
                    stroke: { width: 0 },
                    tooltip: {
                        theme: document.body.getAttribute('data-theme') === 'dark' ? 'dark' : 'light'
                    }
                };

                const options = chart.Type === 'bar'
                    ? {
                        ...commonOptions,
                        chart: {
                            ...commonOptions.chart,
                            type: 'bar',
                            height: 320
                        },
                        series: [{
                            name: chart.Title,
                            data: chart.Values
                        }],
                        xaxis: {
                            categories: chart.Labels,
                            labels: {
                                style: { colors: '#8592a3' }
                            }
                        },
                        yaxis: {
                            labels: {
                                style: { colors: '#8592a3' }
                            }
                        },
                        grid: {
                            borderColor: 'rgba(67, 89, 113, 0.12)',
                            strokeDashArray: 4
                        },
                        plotOptions: {
                            bar: {
                                horizontal: true,
                                borderRadius: 6,
                                distributed: true,
                                barHeight: '62%'
                            }
                        },
                        legend: { show: false }
                    }
                    : chart.Type === 'line'
                        ? {
                            ...commonOptions,
                            chart: {
                                ...commonOptions.chart,
                                type: 'line',
                                height: 320
                            },
                            series: [{
                                name: chart.Title,
                                data: chart.Values
                            }],
                            xaxis: {
                                categories: chart.Labels,
                                labels: {
                                    style: { colors: '#8592a3' }
                                }
                            },
                            yaxis: {
                                labels: {
                                    style: { colors: '#8592a3' }
                                }
                            },
                            stroke: {
                                curve: 'smooth',
                                width: 3
                            },
                            markers: {
                                size: 4
                            },
                            grid: {
                                borderColor: 'rgba(67, 89, 113, 0.12)',
                                strokeDashArray: 4
                            },
                            legend: { show: false }
                        }
                    : {
                        ...commonOptions,
                        chart: {
                            ...commonOptions.chart,
                            type: 'donut',
                            height: 320
                        },
                        labels: chart.Labels,
                        series: chart.Values,
                        legend: {
                            position: 'bottom',
                            fontSize: '13px'
                        },
                        plotOptions: {
                            pie: {
                                donut: {
                                    size: '68%'
                                }
                            }
                        }
                    };

                new ApexCharts(container, options).render();
            });
        })();
    </script>
}
