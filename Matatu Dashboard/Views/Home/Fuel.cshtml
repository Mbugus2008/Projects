@using System.Text.Json
@model Matatu_Dashboard.Models.DashboardSectionViewModel
@{
    Layout = null;
    ViewData["Title"] = "Depot Fuel Dashboard";

    var selectedRange = (ViewData["SelectedRange"] as string) ?? "today";
    var pathBase = Context.Request.PathBase.HasValue ? Context.Request.PathBase.Value! : string.Empty;
    var transactionsBasePath = string.IsNullOrWhiteSpace(pathBase) ? "/d" : pathBase;
    var fuelBasePath = string.IsNullOrWhiteSpace(pathBase) ? "/fuel" : $"{pathBase}/fuel";
    static string BuildRangeLink(string basePath, string? range) => range switch
    {
        "yesterday" => $"{basePath}/yesterday",
        "week" => $"{basePath}/week",
        "month" => $"{basePath}/month",
        _ => $"{basePath}/today"
    };
    var transactionsPageLink = BuildRangeLink(transactionsBasePath, selectedRange);
    var fuelPageLink = BuildRangeLink(fuelBasePath, selectedRange);
    var fuelTodayLink = BuildRangeLink(fuelBasePath, "today");
    var fuelYesterdayLink = BuildRangeLink(fuelBasePath, "yesterday");
    var fuelWeekLink = BuildRangeLink(fuelBasePath, "week");
    var fuelMonthLink = BuildRangeLink(fuelBasePath, "month");
    var retrievedAt = (DateTime?)ViewData["RetrievedAt"] ?? DateTime.Now;
    var overview = Model.Metrics.Take(6).ToList();
    var heroChart = Model.Charts.FirstOrDefault(chart => string.Equals(chart.Type, "line", StringComparison.OrdinalIgnoreCase))
        ?? Model.Charts.FirstOrDefault();
    var secondaryCharts = Model.Charts
        .Where(chart => !string.Equals(chart.Id, heroChart?.Id, StringComparison.OrdinalIgnoreCase))
        .Take(2)
        .ToList();
    var signalCards = Model.Highlights.Take(3).ToList();
    var focusColumns = new[] { "Date", "Vehicle", "Fuel_Agent", "Amount_Paid", "Total_Litres", "Balance", "Management" }
        .Where(column => Model.Columns.Contains(column, StringComparer.OrdinalIgnoreCase))
        .ToList();

    if (focusColumns.Count == 0)
    {
        focusColumns = Model.Columns.Take(7).ToList();
    }

    var focusedRows = Model.Rows.Take(8).ToList();
    var chartsToRender = new[] { heroChart }
        .Where(chart => chart is not null)
        .Select(chart => chart!)
        .Concat(secondaryCharts)
        .ToList();
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"]</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;700&family=Space+Grotesk:wght@500;700&display=swap" rel="stylesheet">
    <style>
        :root {
            color-scheme: light;
            --bg: #f4f8fb;
            --bg-accent: radial-gradient(circle at top left, rgba(239, 125, 87, 0.16), transparent 28%), radial-gradient(circle at top right, rgba(29, 78, 216, 0.18), transparent 24%), linear-gradient(180deg, #fcfffe 0%, #eff5f8 100%);
            --panel: rgba(255, 255, 255, 0.94);
            --panel-strong: #ffffff;
            --border: rgba(20, 33, 61, 0.08);
            --text: #132238;
            --muted: #5f6c7b;
            --primary: #ef7d57;
            --teal: #0f766e;
            --blue: #1d4ed8;
            --accent: #f4b400;
            --shadow: 0 22px 48px rgba(19, 34, 56, 0.08);
        }

        * { box-sizing: border-box; }

        body {
            margin: 0;
            min-height: 100vh;
            font-family: "DM Sans", sans-serif;
            background: var(--bg-accent);
            color: var(--text);
            overflow-x: hidden;
        }

        h1, h2, h3, p { margin: 0; }

        h1, h2, .panel-title, .metric-value, .signal-value {
            font-family: "Space Grotesk", sans-serif;
        }

        .shell {
            max-width: 1320px;
            margin: 0 auto;
            padding: 20px;
        }

        .masthead {
            position: relative;
            overflow: hidden;
            padding: 26px;
            border-radius: 30px;
            background: linear-gradient(135deg, #ef7d57 0%, #f29b55 28%, #0f766e 64%, #1d4ed8 100%);
            color: #fff;
            box-shadow: 0 28px 64px rgba(29, 78, 216, 0.22);
            margin-bottom: 18px;
        }

        .masthead::before,
        .masthead::after {
            content: "";
            position: absolute;
            border-radius: 999px;
            background: rgba(255, 255, 255, 0.09);
        }

        .masthead::before {
            width: 220px;
            height: 220px;
            right: -42px;
            top: -70px;
        }

        .masthead::after {
            width: 180px;
            height: 180px;
            left: 56%;
            bottom: -62px;
            background: rgba(15, 118, 110, 0.18);
        }

        .masthead-grid,
        .overview-grid,
        .layout-grid,
        .split-grid,
        .signal-grid {
            display: grid;
            gap: 14px;
        }

        .masthead-grid {
            position: relative;
            z-index: 1;
            grid-template-columns: 1.2fr 0.8fr;
            align-items: end;
            gap: 18px;
        }

        .eyebrow,
        .panel-tag,
        .metric-label,
        .small-label,
        .table-label,
        .empty-state {
            text-transform: uppercase;
            letter-spacing: 0.08em;
            font-size: 11px;
            font-weight: 700;
        }

        .eyebrow {
            color: rgba(255, 255, 255, 0.82);
            margin-bottom: 10px;
        }

        h1 {
            font-size: 40px;
            line-height: 0.98;
            max-width: 10ch;
            margin-bottom: 10px;
        }

        .subtitle {
            max-width: 56ch;
            color: rgba(255, 255, 255, 0.86);
            font-size: 15px;
            line-height: 1.5;
        }

        .updated {
            margin-top: 14px;
            color: rgba(255, 255, 255, 0.74);
            font-size: 13px;
        }

        .nav-stack {
            display: grid;
            gap: 8px;
            margin-top: 18px;
            max-width: 100%;
        }

        .nav-stack .filters {
            margin-top: 0;
        }

        .filters {
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
            margin-top: 18px;
        }

        .filters a {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-width: 88px;
            padding: 10px 14px;
            border-radius: 999px;
            color: #fff;
            text-decoration: none;
            font-size: 14px;
            font-weight: 700;
            border: 1px solid rgba(255, 255, 255, 0.16);
            background: rgba(255, 255, 255, 0.08);
            backdrop-filter: blur(8px);
        }

        .filters a.active {
            background: #fff;
            border-color: #fff;
            color: var(--primary);
        }

        .headline-card {
            position: relative;
            z-index: 1;
            min-height: 216px;
            border-radius: 24px;
            padding: 18px;
            background: rgba(255, 255, 255, 0.1);
            border: 1px solid rgba(255, 255, 255, 0.18);
            backdrop-filter: blur(10px);
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }

        .headline-card h2 {
            font-size: 22px;
            margin-top: 6px;
            margin-bottom: 4px;
        }

        .headline-card p {
            color: rgba(255, 255, 255, 0.76);
            font-size: 13px;
        }

        .headline-kpi {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 10px;
            margin-top: 16px;
        }

        .headline-kpi article {
            border-radius: 18px;
            padding: 12px;
            background: rgba(255, 255, 255, 0.12);
            border: 1px solid rgba(255, 255, 255, 0.14);
        }

        .headline-kpi strong {
            display: block;
            font-family: "Space Grotesk", sans-serif;
            font-size: 26px;
            margin-top: 4px;
        }

        .overview-grid {
            grid-template-columns: repeat(6, minmax(0, 1fr));
            margin: 18px 0;
        }

        .metric-card,
        .panel,
        .recent-table {
            border: 1px solid var(--border);
            border-radius: 24px;
            background: var(--panel);
            box-shadow: var(--shadow);
        }

        .metric-card {
            min-height: 132px;
            padding: 16px;
            background: linear-gradient(180deg, rgba(255, 255, 255, 0.98), rgba(247, 249, 251, 0.96));
        }

        .metric-card:nth-child(1) { background: linear-gradient(135deg, rgba(239, 125, 87, 0.14), rgba(255, 255, 255, 0.98)); }
        .metric-card:nth-child(2) { background: linear-gradient(135deg, rgba(29, 78, 216, 0.12), rgba(255, 255, 255, 0.98)); }
        .metric-card:nth-child(3) { background: linear-gradient(135deg, rgba(15, 118, 110, 0.13), rgba(255, 255, 255, 0.98)); }
        .metric-card:nth-child(4) { background: linear-gradient(135deg, rgba(244, 180, 0, 0.16), rgba(255, 255, 255, 0.98)); }

        .metric-label { color: var(--muted); margin-bottom: 10px; }

        .metric-value,
        .panel-title,
        .signal-title,
        .signal-value { overflow-wrap: anywhere; }

        .metric-value { font-size: 24px; line-height: 1.02; }

        .metric-note {
            margin-top: 8px;
            color: var(--muted);
            font-size: 12px;
            line-height: 1.45;
        }

        .layout-grid {
            grid-template-columns: 1.35fr 0.95fr;
            gap: 16px;
        }

        .split-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 16px;
        }

        .panel {
            padding: 18px;
            background: linear-gradient(180deg, rgba(255, 255, 255, 0.98), rgba(248, 251, 255, 0.95));
        }

        .panel-hero { min-height: 430px; }
        .panel-signals,
        .panel-recent { grid-column: 1 / -1; }

        .panel-head {
            display: flex;
            justify-content: space-between;
            gap: 14px;
            align-items: start;
            margin-bottom: 16px;
        }

        .panel-tag { color: var(--muted); margin-bottom: 6px; }

        .panel-title {
            font-size: 25px;
            line-height: 1;
            margin-bottom: 6px;
        }

        .panel-copy {
            color: var(--muted);
            font-size: 14px;
            line-height: 1.55;
            max-width: 54ch;
        }

        .pill {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 999px;
            padding: 8px 12px;
            background: rgba(239, 125, 87, 0.08);
            color: var(--primary);
            font-size: 12px;
            font-weight: 800;
            white-space: nowrap;
        }

        .chart-canvas-large,
        .chart-canvas-medium { width: 100%; }
        .chart-canvas-large { min-height: 320px; }
        .chart-canvas-medium { min-height: 270px; }

        .signal-grid { grid-template-columns: 1fr; }

        .signal-card {
            border: 1px solid var(--border);
            border-radius: 20px;
            padding: 14px;
            background: var(--panel-strong);
        }

        .signal-card h3 { font-size: 17px; margin-bottom: 8px; }

        .signal-title { font-weight: 700; line-height: 1.3; }

        .signal-value {
            font-size: 24px;
            line-height: 1;
            margin: 8px 0;
        }

        .signal-note,
        .table-subtle {
            color: var(--muted);
            font-size: 12px;
        }

        .recent-table { overflow: hidden; }
        .table-wrap { overflow-x: auto; -webkit-overflow-scrolling: touch; }

        table.data-table {
            width: 100%;
            border-collapse: collapse;
            min-width: 780px;
        }

        table.data-table th,
        table.data-table td {
            padding: 12px 10px;
            border-bottom: 1px solid rgba(20, 33, 61, 0.06);
            text-align: left;
            font-size: 13px;
            white-space: nowrap;
        }

        table.data-table th {
            color: var(--muted);
            font-size: 11px;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            background: rgba(242, 247, 243, 0.88);
        }

        table.data-table td::before { display: none; }

        .empty-state,
        .error {
            border-radius: 20px;
            padding: 16px;
            border: 1px solid var(--border);
            background: rgba(255, 255, 255, 0.94);
        }

        .error {
            color: #b91c1c;
            background: #fff3f2;
            border-color: rgba(185, 28, 28, 0.18);
            margin-bottom: 16px;
        }

        @@media (max-width: 1120px) {
            .overview-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
        }

        @@media (max-width: 920px) {
            .masthead-grid,
            .layout-grid,
            .split-grid { grid-template-columns: 1fr; }

            .overview-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }

            h1 { font-size: 31px; }

            .headline-card,
            .panel-hero { min-height: auto; }
        }

        @@media (max-width: 760px) {
            .nav-stack {
                width: 100%;
            }

            .filters {
                display: grid;
                grid-template-columns: repeat(2, minmax(0, 1fr));
                width: 100%;
            }

            .page-links {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }

            .range-links {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }

            .filters a {
                min-width: 0;
                width: 100%;
                min-height: 46px;
                padding: 10px 8px;
            }

            .chart-canvas-large { min-height: 280px; }
            .chart-canvas-medium { min-height: 240px; }

            .table-wrap { overflow: visible; }
            table.data-table { min-width: 0; }

            table.data-table thead {
                position: absolute;
                width: 1px;
                height: 1px;
                padding: 0;
                margin: -1px;
                overflow: hidden;
                clip: rect(0, 0, 0, 0);
                border: 0;
            }

            table.data-table,
            table.data-table tbody,
            table.data-table tr,
            table.data-table td {
                display: block;
                width: 100%;
            }

            table.data-table tr {
                border: 1px solid rgba(20, 33, 61, 0.08);
                border-radius: 18px;
                padding: 12px 14px;
                margin-bottom: 10px;
                background: rgba(255, 255, 255, 0.94);
            }

            table.data-table td {
                display: grid;
                grid-template-columns: 88px minmax(0, 1fr);
                gap: 10px;
                padding: 8px 0;
                border-bottom: 1px solid rgba(20, 33, 61, 0.06);
                white-space: normal;
                text-align: left;
            }

            table.data-table td:last-child {
                border-bottom: 0;
                padding-bottom: 0;
            }

            table.data-table td::before {
                content: attr(data-label);
                display: block;
                color: var(--muted);
                font-size: 10px;
                font-weight: 700;
                text-transform: uppercase;
                letter-spacing: 0.08em;
            }
        }

        @@media (max-width: 600px) {
            .shell { padding: 10px; }

            .masthead,
            .panel,
            .metric-card,
            .recent-table { border-radius: 20px; }

            .masthead,
            .panel,
            .metric-card { padding: 16px; }

            .overview-grid,
            .headline-kpi { grid-template-columns: 1fr; }

            .panel-head {
                flex-direction: column;
                align-items: stretch;
            }

            h1 {
                font-size: 28px;
                max-width: none;
            }

            .panel-title { font-size: 22px; }
            .subtitle,
            .panel-copy { font-size: 13px; }
            .pill { align-self: flex-start; white-space: normal; }
        }
    </style>
</head>
<body>
    <main class="shell">
        <section class="masthead">
            <div class="masthead-grid">
                <div>
                    <div class="eyebrow">Fuel Control View</div>
                    <h1>Depot fuel activity in one operating board.</h1>
                    <p class="subtitle">Use this page for payment pressure, vehicle-level fuel draw, agent visibility, and operating balance signals without mixing the feed into collections.</p>
                    <div class="updated">Updated @retrievedAt.ToString("dd MMM yyyy HH:mm")</div>
                    <div class="nav-stack">
                        <nav class="filters page-links" aria-label="Page links">
                            <a href="@transactionsPageLink">Transactions</a>
                            <a href="@fuelPageLink" class="active">Depot Fuel</a>
                        </nav>
                        <nav class="filters range-links" aria-label="Date range">
                            <a href="@fuelTodayLink" class="@(selectedRange == "today" ? "active" : null)">Today</a>
                            <a href="@fuelYesterdayLink" class="@(selectedRange == "yesterday" ? "active" : null)">Yesterday</a>
                            <a href="@fuelWeekLink" class="@(selectedRange == "week" ? "active" : null)">Week</a>
                            <a href="@fuelMonthLink" class="@(selectedRange == "month" ? "active" : null)">Month</a>
                        </nav>
                    </div>
                </div>

                <div class="headline-card">
                    <div>
                        <div class="eyebrow">Fast Read</div>
                        <h2>Fuel control priorities</h2>
                        <p>Track payments, spot the vehicles drawing the most fuel, and keep operational balances visible before they drift into leakage.</p>
                    </div>
                    <div class="headline-kpi">
                        <article>
                            <span class="small-label">Records</span>
                            <strong>@Model.TotalRecords.ToString("N0")</strong>
                        </article>
                        <article>
                            <span class="small-label">Charts</span>
                            <strong>@Model.Charts.Count</strong>
                        </article>
                        <article>
                            <span class="small-label">Signals</span>
                            <strong>@signalCards.Count</strong>
                        </article>
                    </div>
                </div>
            </div>
        </section>

        @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
        {
            <div class="error">@Model.ErrorMessage</div>
        }
        else
        {
            <section class="overview-grid">
                @foreach (var metric in overview)
                {
                    <article class="metric-card">
                        <div class="metric-label">@metric.Label</div>
                        <div class="metric-value">@metric.Value</div>
                        <div class="metric-note">@(string.IsNullOrWhiteSpace(metric.Note) ? "Focused depot fuel slice from Business Central" : metric.Note)</div>
                    </article>
                }
            </section>

            <section class="layout-grid">
                <article class="panel panel-hero">
                    <div class="panel-head">
                        <div>
                            <div class="panel-tag">Fuel Trend</div>
                            <h2 class="panel-title">Fuel Spend Pace</h2>
                            <p class="panel-copy">Use the trend as the operating heartbeat. If fuel payments spike without matching offload or balance behavior, the control team should inspect the raw entries immediately.</p>
                        </div>
                        <div class="pill">Latest @Model.TotalRecords.ToString("N0") fuel records</div>
                    </div>

                    @if (heroChart is not null)
                    {
                        <div id="@heroChart.Id" class="chart-canvas-large"></div>
                    }
                    else
                    {
                        <div class="empty-state">No fuel trend chart is available for the current response.</div>
                    }
                </article>

                <article class="panel">
                    <div class="panel-head">
                        <div>
                            <div class="panel-tag">Control Rail</div>
                            <h2 class="panel-title">Key Fuel Signals</h2>
                            <p class="panel-copy">These are the highest-signal entries from the slice currently loaded into the page.</p>
                        </div>
                    </div>

                    @if (signalCards.Count > 0)
                    {
                        <div class="signal-grid">
                            @foreach (var signal in signalCards)
                            {
                                <article class="signal-card">
                                    <div class="panel-tag">@signal.Label</div>
                                    <div class="signal-title">@signal.Title</div>
                                    <div class="signal-value">@signal.Value</div>
                                    <div class="signal-note">Fuel exception or concentration signal from the current feed slice.</div>
                                </article>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="empty-state">No fuel signals are available for the current response.</div>
                    }
                </article>

                <article class="panel panel-signals">
                    <div class="panel-head">
                        <div>
                            <div class="panel-tag">Fuel Mix</div>
                            <h2 class="panel-title">Operational Fuel Views</h2>
                            <p class="panel-copy">Review vehicle concentration, agent distribution, and highest-payment entries without dropping into the raw table first.</p>
                        </div>
                    </div>

                    @if (secondaryCharts.Count > 0)
                    {
                        <div class="split-grid">
                            @foreach (var chart in secondaryCharts)
                            {
                                <article class="panel">
                                    <div class="panel-head">
                                        <div>
                                            <div class="panel-tag">Chart</div>
                                            <h3 class="panel-title" style="font-size: 21px;">@chart.Title</h3>
                                        </div>
                                    </div>
                                    <div id="@chart.Id" class="chart-canvas-medium"></div>
                                </article>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="empty-state">No secondary fuel charts are available for the current response.</div>
                    }
                </article>

                <article class="panel panel-recent recent-table">
                    <div class="panel-head">
                        <div>
                            <div class="panel-tag">Fuel Feed</div>
                            <h2 class="panel-title">Focused Fuel Rows</h2>
                            <p class="panel-copy">This table is intentionally trimmed to the operational fields that matter most for quick review.</p>
                        </div>
                        <div class="pill">@focusedRows.Count row(s)</div>
                    </div>

                    @if (focusColumns.Count == 0 || focusedRows.Count == 0)
                    {
                        <div class="empty-state">No depot fuel rows are available.</div>
                    }
                    else
                    {
                        <div class="table-wrap">
                            <table class="data-table">
                                <thead>
                                    <tr>
                                        @foreach (var column in focusColumns)
                                        {
                                            <th>@column.Replace("_", " ")</th>
                                        }
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var row in focusedRows)
                                    {
                                        <tr>
                                            @foreach (var column in focusColumns)
                                            {
                                                <td data-label="@column.Replace("_", " ")">@row[column]</td>
                                            }
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </article>
            </section>
        }
    </main>

    <script src="https://cdn.jsdelivr.net/npm/apexcharts"></script>
    <script>
        (() => {
            const charts = @Html.Raw(JsonSerializer.Serialize(chartsToRender));
            const palette = ["#ef7d57", "#0f766e", "#1d4ed8", "#f4b400", "#14b8a6", "#7c3aed"];

            charts.forEach((chart) => {
                const container = document.getElementById(chart.Id);
                if (!container) {
                    return;
                }

                const colors = chart.Labels.map((_, index) => palette[index % palette.length]);
                const base = {
                    chart: {
                        fontFamily: 'DM Sans, sans-serif',
                        toolbar: { show: false },
                        animations: { easing: 'easeinout', speed: 500 }
                    },
                    colors,
                    dataLabels: { enabled: false },
                    legend: { show: false },
                    tooltip: { theme: 'light' }
                };

                let options;

                if (chart.Type === 'bar') {
                    options = {
                        ...base,
                        chart: { ...base.chart, type: 'bar', height: 300 },
                        series: [{ name: chart.Title, data: chart.Values }],
                        xaxis: {
                            categories: chart.Labels,
                            labels: { style: { colors: '#5f6c7b', fontSize: '11px' } }
                        },
                        yaxis: { labels: { style: { colors: '#5f6c7b' } } },
                        grid: { borderColor: 'rgba(20, 33, 61, 0.08)', strokeDashArray: 4 },
                        plotOptions: {
                            bar: {
                                horizontal: true,
                                borderRadius: 10,
                                distributed: true,
                                barHeight: '58%'
                            }
                        }
                    };
                } else if (chart.Type === 'line') {
                    options = {
                        ...base,
                        chart: { ...base.chart, type: 'area', height: 320 },
                        series: [{ name: chart.Title, data: chart.Values }],
                        xaxis: {
                            categories: chart.Labels,
                            labels: { style: { colors: '#5f6c7b', fontSize: '11px' } }
                        },
                        yaxis: { labels: { style: { colors: '#5f6c7b' } } },
                        stroke: { curve: 'smooth', width: 4 },
                        markers: { size: 4, hover: { size: 6 } },
                        fill: {
                            type: 'gradient',
                            gradient: {
                                shadeIntensity: 1,
                                opacityFrom: 0.34,
                                opacityTo: 0.04,
                                stops: [0, 92, 100]
                            }
                        },
                        grid: { borderColor: 'rgba(20, 33, 61, 0.08)', strokeDashArray: 4 }
                    };
                } else {
                    options = {
                        ...base,
                        chart: { ...base.chart, type: 'donut', height: 260 },
                        labels: chart.Labels,
                        series: chart.Values,
                        legend: {
                            show: true,
                            position: 'bottom',
                            fontSize: '12px'
                        },
                        stroke: { width: 0 },
                        plotOptions: {
                            pie: {
                                donut: { size: '70%' }
                            }
                        }
                    };
                }

                new ApexCharts(container, options).render();
            });
        })();
    </script>
</body>
</html>