@model Matatu_Dashboard.Models.DashboardSectionViewModel
@{
    Layout = null;
    var selectedRange = (ViewData["SelectedRange"] as string) ?? "today";
    var todayStr = DateTime.Today.ToString("yyyy-MM-dd");
    var yesterdayStr = DateTime.Today.AddDays(-1).ToString("yyyy-MM-dd");
    // Show selected date in the date picker (only for specific date ranges)
    var initialDate = DateTime.TryParseExact(selectedRange, "yyyy-MM-dd", null,
        System.Globalization.DateTimeStyles.None, out var parsedDate)
        ? parsedDate.ToString("yyyy-MM-dd")
        : todayStr;
    var pathBase = Context.Request.PathBase.HasValue ? Context.Request.PathBase.Value! : string.Empty;
    var summaryBasePath = string.IsNullOrWhiteSpace(pathBase) ? "/dispatchsummary" : $"{pathBase}/dispatchsummary";
    var retrievedAt = (DateTime?)ViewData["RetrievedAt"] ?? DateTime.Now;
    var summary = ViewData["Summary"] as Matatu_Dashboard.Models.DashboardSectionViewModel;
    var summaryRows = summary?.Rows ?? new();
    var summaryCols = summary?.Columns ?? new();
    var depotRows = Model.Rows;
    var depotCols = Model.Columns;

    // Active vehicles are counted from depot rows where On_route is checked.
    var activeVehicles = depotRows.Count(r => r.TryGetValue("On_route", out var ov) && string.Equals(ov, "true", StringComparison.OrdinalIgnoreCase));
    var totalVehicles = summaryRows.Sum(r => r.TryGetValue("Total_Vehicles", out var tv) && int.TryParse(tv, out var tvi) ? tvi : 0);
    var totalCollection = (decimal)summaryRows.Sum(r => r.TryGetValue("Total_Collection", out var v) && decimal.TryParse(v, out var d) ? d : 0);
    var netOffload = (decimal)summaryRows.Sum(r => r.TryGetValue("Net_Offload", out var v) && decimal.TryParse(v, out var d) ? d : 0);

    // Depot columns in display order (dispatch focus, no fuel columns)
    var depotFocusCols = new[] { "Date", "Vehicle", "Fleet", "Crew", "Crew_Name", "On_route",
        "Nro_Defects", "Description",
        "Tlb_Expiry", "Insurance_expiry", "Driver_Licence_Expiry",
        "Conductor_Licence_Expiry", "Driver_Badge_Expiry", "Conductor_Badge_Expiry",
        "Inspection_Expiry" }
        .Where(c => c is "Crew" or "Crew_Name" || depotCols.Contains(c, StringComparer.OrdinalIgnoreCase)).ToList();

    // Friendly labels for columns
    var depotColLabels = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase) {
        {"Date", "Date"}, {"Vehicle", "Vehicle"}, {"Fleet", "Fleet"},
        {"Crew", "Crew No"}, {"Crew_Name", "Crew Name"}, {"On_route", "On Route"},
        {"Nro_Defects", "Defects"}, {"Description", "Description"},
        {"Tlb_Expiry", "TLB Expiry"}, {"Insurance_expiry", "Insurance Expiry"},
        {"Driver_Licence_Expiry", "Driver Licence"}, {"Conductor_Licence_Expiry", "Conductor Licence"},
        {"Driver_Badge_Expiry", "Driver Badge"}, {"Conductor_Badge_Expiry", "Conductor Badge"},
        {"Inspection_Expiry", "Inspection Expiry"}
    };

    // Expiry date columns rendered as Valid/Invalid badges
    var expiryCols = new HashSet<string>(StringComparer.OrdinalIgnoreCase) {
        "Tlb_Expiry", "Insurance_expiry", "Driver_Licence_Expiry",
        "Conductor_Licence_Expiry", "Driver_Badge_Expiry", "Conductor_Badge_Expiry",
        "Inspection_Expiry"
    };

    // Monetary columns to format with N2 and right-align
    var moneyCols = new HashSet<string>(StringComparer.OrdinalIgnoreCase) {
    };

    // Order: active (On route) first, then by vehicle
    var orderedDepotRows = depotRows
        .OrderByDescending(r => r.TryGetValue("On_route", out var rv) && string.Equals(rv, "true", StringComparison.OrdinalIgnoreCase))
        .ThenBy(r => r.TryGetValue("Vehicle", out var vv) ? vv : "")
        .ToList();
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"]</title>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;700&display=swap" rel="stylesheet">
    <style>
        :root { color-scheme: light; }
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: 'DM Sans', sans-serif; background: #f4f6f9; color: #1a1a2e; padding: 16px; }
        .header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; flex-wrap: wrap; gap: 8px; }
        .header h1 { font-size: 20px; font-weight: 700; }
        .tabs { display: flex; gap: 4px; flex-wrap: wrap; }
        .tabs a { padding: 6px 14px; border-radius: 6px; text-decoration: none; font-size: 13px; font-weight: 500; color: #555; background: #e8ecf1; }
        .tabs a.active { background: #006B3F; color: #fff; }
        .metrics { display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 10px; margin-bottom: 16px; }
        .metric-card { background: #fff; border-radius: 10px; padding: 14px; box-shadow: 0 1px 3px rgba(0,0,0,.08); text-align: center; }
        .metric-card .label { font-size: 11px; color: #888; text-transform: uppercase; letter-spacing: .5px; }
        .metric-card .value { font-size: 22px; font-weight: 700; color: #006B3F; margin-top: 4px; }
        .metric-card .value.red { color: #d32f2f; }
        .metric-card .value.blue { color: #1565c0; }
        table { width: 100%; border-collapse: collapse; background: #fff; border-radius: 10px; overflow: hidden; box-shadow: 0 1px 3px rgba(0,0,0,.08); }
        th { background: #006B3F; color: #fff; padding: 10px 8px; font-size: 12px; text-align: left; white-space: nowrap; }
        td { padding: 8px; font-size: 13px; border-bottom: 1px solid #eee; white-space: nowrap; }
        tr:last-child td { border-bottom: none; }
        .footer { margin-top: 12px; font-size: 11px; color: #999; text-align: center; }
        .table-wrap { width: 100%; overflow-x: auto; -webkit-overflow-scrolling: touch; }
        .table-wrap table { min-width: 800px; }
        @@media (max-width: 640px) {
            body { padding: 10px; }
            .header { flex-direction: column; align-items: flex-start; }
            .header h1 { font-size: 17px; }
            .tabs a { padding: 5px 10px; font-size: 12px; }
            .metrics { grid-template-columns: repeat(2, 1fr); gap: 8px; }
            .metric-card { padding: 10px; }
            .metric-card .value { font-size: 18px; }
            .metric-card .label { font-size: 10px; }
        }
    </style>
</head>
<body>
    <div class="header">
        <h1>@ViewData["Title"]</h1>
        <div class="tabs">
            <a href="@summaryBasePath/today" class="@(selectedRange == "today" || selectedRange == todayStr ? "active" : "")">Today</a>
            <a href="@summaryBasePath/yesterday" class="@(selectedRange == "yesterday" || selectedRange == yesterdayStr ? "active" : "")">Yesterday</a>
            <a href="@summaryBasePath/week" class="@(selectedRange == "week" ? "active" : "")">Week</a>
            <a href="@summaryBasePath/month" class="@(selectedRange == "month" ? "active" : "")">Month</a>
        </div>
    </div>

    <div class="controls" style="display:flex;gap:8px;margin-bottom:12px;flex-wrap:wrap;">
        <input type="date" id="dateFilter" value="@initialDate"
               style="padding:8px;border:1px solid #ccc;border-radius:6px;font-family:inherit;"
               onchange="if(this.value){window.location.href='@summaryBasePath/'+this.value;}" />
        <input type="text" id="vehicleFilter" placeholder="Search vehicle, fleet or crew"
               style="padding:8px;border:1px solid #ccc;border-radius:6px;font-family:inherit;flex:1;min-width:160px;"
               oninput="filterVehicles()" onkeyup="filterVehicles()" />
    </div>

    <script>
        function filterVehicles() {
            var q = document.getElementById('vehicleFilter').value.toUpperCase();
            var rows = document.querySelectorAll('#depotTable tbody tr');
            rows.forEach(function (row) {
                var vehicle = row.cells[1] ? row.cells[1].textContent.toUpperCase() : '';
                var fleet = row.cells[2] ? row.cells[2].textContent.toUpperCase() : '';
                var crew = row.cells[3] ? row.cells[3].textContent.toUpperCase() : '';
                row.style.display = (!q || vehicle.indexOf(q) >= 0 || fleet.indexOf(q) >= 0 || crew.indexOf(q) >= 0) ? '' : 'none';
            });
        }
    </script>

    <div class="metrics">
        <div class="metric-card">
            <div class="label">Vehicles (Active/Total)</div>
            <div class="value">@activeVehicles/@totalVehicles</div>
        </div>
        <div class="metric-card">
            <div class="label">Active Vehicles</div>
            <div class="value">@activeVehicles</div>
        </div>
        <div class="metric-card">
            <div class="label">Total Collection</div>
            <div class="value blue">@totalCollection.ToString("N2")</div>
        </div>
        <div class="metric-card">
            <div class="label">Net Offload</div>
            <div class="value">@netOffload.ToString("N2")</div>
        </div>
    </div>

    <div class="table-wrap">
    <table id="depotTable">
        <thead>
            <tr>
                @foreach (var col in depotFocusCols)
                {
                    <th style="@(moneyCols.Contains(col) ? "text-align:right;" : "")">@(depotColLabels.TryGetValue(col, out var label) ? label : col.Replace("_", " "))</th>
                }
            </tr>
        </thead>
        <tbody>
            @foreach (var row in orderedDepotRows)
            {
                var isRouteRow = row.TryGetValue("On_route", out var orv) && string.Equals(orv, "true", StringComparison.OrdinalIgnoreCase);
                <tr style="color:@(isRouteRow ? "#2e7d32" : "#d32f2f");">
                    @foreach (var col in depotFocusCols)
                    {
                        if (col == "Crew")
                        {
                            var driver = row.TryGetValue("Driver", out var dv) ? dv : "-";
                            var conductor = row.TryGetValue("Conductor", out var cv) ? cv : "-";
                            <td>
                                <div>@driver</div>
                                <div>@conductor</div>
                            </td>
                            continue;
                        }
                        if (col == "Crew_Name")
                        {
                            var driverName = row.TryGetValue("Driver_Name", out var dn) ? dn : "-";
                            var conductorName = row.TryGetValue("Conductor_Name", out var cn) ? cn : "-";
                            <td>
                                <div>@driverName</div>
                                <div>@conductorName</div>
                            </td>
                            continue;
                        }
                        if (col == "On_route")
                        {
                            var isRoute = row.TryGetValue("On_route", out var rv) && string.Equals(rv, "true", StringComparison.OrdinalIgnoreCase);
                            <td style="text-align:center;">
                                <span style="display:inline-block;padding:2px 10px;border-radius:12px;font-size:11px;font-weight:600;color:#fff;background:@(isRoute ? "#2e7d32" : "#d32f2f");">@(isRoute ? "Yes" : "No")</span>
                            </td>
                            continue;
                        }
                        var val = row.TryGetValue(col, out var v) ? v : "-";
                        decimal? numVal = null;
                        if (expiryCols.Contains(col))
                        {
                            if (val != "-" && !string.IsNullOrWhiteSpace(val) && DateTime.TryParse(val, out var exp))
                            {
                                var isFuture = exp.Date > DateTime.Today;
                                var badgeColor = isFuture ? "#2e7d32" : "#d32f2f";
                                <td style="text-align:center;">
                                    <span style="display:inline-block;padding:2px 10px;border-radius:12px;font-size:11px;font-weight:600;color:#fff;background:@badgeColor;">@(isFuture ? "Valid" : "Invalid")</span>
                                    <div style="font-size:10px;color:#888;margin-top:2px;">@exp.ToString("dd MMM yyyy")</div>
                                </td>
                            }
                            else
                            {
                                <td style="text-align:center;color:#bbb;">-</td>
                            }
                            continue;
                        }
                        if (col == "Date" && val != "-")
                        {
                            val = val.Length > 11 ? val.Substring(0, 11).Trim() : val;
                        }
                        else if (moneyCols.Contains(col) && val != "-" && decimal.TryParse(val, out var parsed))
                        {
                            numVal = parsed;
                            val = parsed.ToString("N2");
                        }
                        var cellStyle = "";
                        <td style="@cellStyle">@val</td>
                    }
                </tr>
            }
        </tbody>
    </table>
    </div>

    @if (orderedDepotRows.Count == 0)
    {
        <p style="text-align:center;color:#999;margin-top:40px;">No dispatch data for this period.</p>
    }

    <div class="footer">
        @orderedDepotRows.Count dispatch records · Retrieved @retrievedAt.ToString("HH:mm:ss") · @selectedRange
    </div>
</body>
</html>
