@model Matatu_Dashboard.Models.LoadingTripsViewModel
@{
    Layout = null;
    var selectedRange = (ViewData["SelectedRange"] as string) ?? "today";
    var todayStr = DateTime.Today.ToString("yyyy-MM-dd");
    var pathBase = Context.Request.PathBase.HasValue ? Context.Request.PathBase.Value! : string.Empty;
    var baseUrl = string.IsNullOrWhiteSpace(pathBase) ? "/loading" : $"{pathBase}/loading";
    var retrievedAt = Model.RetrievedAt;

    string Tone(double pressure) => pressure >= 60 ? "high" : pressure >= 35 ? "medium" : "low";
    string BarClass(double pressure) => pressure >= 60 ? "bar-high" : pressure >= 35 ? "bar-medium" : "bar-low";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"]</title>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;700&display=swap" rel="stylesheet">
    <style>
        :root { color-scheme: light; }
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: 'DM Sans', sans-serif; background: #f4f6f9; color: #1a1a2e; padding: 16px; }
        .header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px; flex-wrap: wrap; gap: 8px; }
        .header h1 { font-size: 20px; font-weight: 700; }
        .header .sub { font-size: 12px; color: #888; margin-top: 2px; }
        .tabs { display: flex; gap: 4px; flex-wrap: wrap; }
        .tabs a { padding: 6px 14px; border-radius: 6px; text-decoration: none; font-size: 13px; font-weight: 500; color: #555; background: #e8ecf1; }
        .tabs a.active { background: #006B3F; color: #fff; }
        .callout { background: #fff; border-left: 4px solid #006B3F; border-radius: 8px; padding: 14px 16px; margin-bottom: 16px; box-shadow: 0 1px 3px rgba(0,0,0,.08); }
        .callout h2 { font-size: 13px; text-transform: uppercase; letter-spacing: .6px; color: #006B3F; margin-bottom: 8px; }
        .callout ul { list-style: none; }
        .callout li { font-size: 13.5px; line-height: 1.55; padding: 5px 0 5px 18px; position: relative; }
        .callout li::before { content: ''; position: absolute; left: 4px; top: 12px; width: 6px; height: 6px; border-radius: 50%; background: #006B3F; }
        .metrics { display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 10px; margin-bottom: 16px; }
        .metric-card { background: #fff; border-radius: 10px; padding: 14px; box-shadow: 0 1px 3px rgba(0,0,0,.08); text-align: center; }
        .metric-card .label { font-size: 11px; color: #888; text-transform: uppercase; letter-spacing: .5px; }
        .metric-card .value { font-size: 22px; font-weight: 700; color: #006B3F; margin-top: 4px; }
        .metric-card .value.red { color: #d32f2f; }
        .metric-card .value.amber { color: #ef6c00; }
        .metric-card .note { font-size: 11px; color: #999; margin-top: 3px; }
        .panel { background: #fff; border-radius: 10px; padding: 16px; box-shadow: 0 1px 3px rgba(0,0,0,.08); margin-bottom: 16px; }
        .panel h2 { font-size: 14px; font-weight: 700; margin-bottom: 4px; }
        .panel .hint { font-size: 12px; color: #888; margin-bottom: 12px; }
        .bar-row { display: grid; grid-template-columns: 62px 1fr 130px; align-items: center; gap: 10px; padding: 3px 0; }
        .bar-row .hour { font-size: 12.5px; color: #444; font-weight: 500; }
        .bar-track { background: #eef1f5; border-radius: 4px; height: 16px; overflow: hidden; }
        .bar-fill { height: 100%; border-radius: 4px; }
        .bar-low { background: #66bb6a; }
        .bar-medium { background: #ffa726; }
        .bar-high { background: #e53935; }
        .bar-row .detail { font-size: 12px; color: #666; text-align: right; }
        table { width: 100%; border-collapse: collapse; background: #fff; border-radius: 10px; overflow: hidden; box-shadow: 0 1px 3px rgba(0,0,0,.08); }
        th { background: #006B3F; color: #fff; padding: 10px 8px; font-size: 12px; text-align: left; white-space: nowrap; }
        td { padding: 8px; font-size: 13px; border-bottom: 1px solid #eee; white-space: nowrap; }
        tr:last-child td { border-bottom: none; }
        .pill { display: inline-block; padding: 2px 8px; border-radius: 10px; font-size: 11.5px; font-weight: 700; }
        .pill.high { background: #fdecea; color: #c62828; }
        .pill.medium { background: #fff4e5; color: #ef6c00; }
        .pill.low { background: #e8f5e9; color: #2e7d32; }
        .empty { background: #fff; border-radius: 10px; padding: 28px; text-align: center; color: #777; font-size: 13.5px; box-shadow: 0 1px 3px rgba(0,0,0,.08); }
        .error { background: #fdecea; color: #b71c1c; border-radius: 8px; padding: 12px 14px; font-size: 13px; margin-bottom: 16px; }
        .footer { margin-top: 12px; font-size: 11px; color: #999; text-align: center; }
        .table-wrap { width: 100%; overflow-x: auto; -webkit-overflow-scrolling: touch; }
        @@media (max-width: 640px) {
            body { padding: 10px; }
            .header { flex-direction: column; align-items: flex-start; }
            .header h1 { font-size: 17px; }
            .tabs a { padding: 5px 10px; font-size: 12px; }
            .metrics { grid-template-columns: repeat(2, 1fr); gap: 8px; }
            .metric-card { padding: 10px; }
            .metric-card .value { font-size: 18px; }
            .metric-card .label { font-size: 10px; }
            .bar-row { grid-template-columns: 52px 1fr 96px; gap: 6px; }
            .bar-row .detail { font-size: 11px; }
        }
    </style>
</head>
<body>
    <div class="header">
        <div>
            <h1>Loading Performance</h1>
            <div class="sub">@Model.FilterDescription</div>
        </div>
        <div class="tabs">
            <a href="@baseUrl/today" class="@(selectedRange == "today" || selectedRange == todayStr ? "active" : "")">Today</a>
            <a href="@baseUrl/yesterday" class="@(selectedRange == "yesterday" ? "active" : "")">Yesterday</a>
            <a href="@baseUrl/week" class="@(selectedRange == "week" ? "active" : "")">This week</a>
            <a href="@baseUrl/month" class="@(selectedRange == "month" ? "active" : "")">This month</a>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="error">Could not load loading data: @Model.ErrorMessage</div>
    }

    @if (!Model.HasData)
    {
        <div class="empty">
            No loading activity recorded for this period.<br />
            <span style="font-size:12px">A trip appears here once a vehicle enters a loading point, stays long enough to load, and leaves.</span>
        </div>
    }
    else
    {
        @if (Model.Takeaways.Count > 0)
        {
            <div class="callout">
                <h2>What this means</h2>
                <ul>
                    @foreach (var note in Model.Takeaways)
                    {
                        <li>@note</li>
                    }
                </ul>
            </div>
        }

        <div class="metrics">
            <div class="metric-card">
                <div class="label">Trips loaded</div>
                <div class="value">@Model.Trips.ToString("N0")</div>
                <div class="note">Vehicles that completed loading</div>
            </div>
            <div class="metric-card">
                <div class="label">Went round</div>
                <div class="value red">@Model.WentRound.ToString("N0")</div>
                <div class="note">Arrivals that could not load</div>
            </div>
            <div class="metric-card">
                <div class="label">Loaded first time</div>
                <div class="value @(Model.LoadedFirstTimePct < 40 ? "red" : Model.LoadedFirstTimePct < 65 ? "amber" : "")">@Model.LoadedFirstTimePct.ToString("0.#")%</div>
                <div class="note">Of @Model.LoadedVisits.ToString("N0") vehicles that queued to load</div>
            </div>
            <div class="metric-card">
                <div class="label">Rounds per trip</div>
                <div class="value">@Model.LoopsPerTrip.ToString("0.##")</div>
                <div class="note">Extra loops before each load</div>
            </div>
            <div class="metric-card">
                <div class="label">Time in bay</div>
                <div class="value">@Model.AverageLoadingMinutes.ToString("0.#")m</div>
                <div class="note">Average per completed load</div>
            </div>
            <div class="metric-card">
                <div class="label">Vehicles</div>
                <div class="value">@Model.Vehicles.ToString("N0")</div>
                <div class="note">Across @Model.LoadingPoints loading point(s)</div>
            </div>
        </div>

        @if (Model.Hours.Count > 0)
        {
            var worst = Model.WorstHourLabel;
            var best = Model.BestHourLabel;
            <div class="panel">
                <h2>Loading bay pressure by hour</h2>
                <div class="hint">
                    Red bars are when vehicles most often found the bay full and had to go round.
                    @if (worst is not null && best is not null)
                    {
                        <text>Busiest around <strong>@worst</strong> (@Model.WorstHourPressure.ToString("0")%), easiest around <strong>@best</strong> (@Model.BestHourPressure.ToString("0")%).</text>
                    }
                </div>
                @foreach (var hour in Model.Hours)
                {
                    var total = hour.Trips + hour.WentRound;
                    <div class="bar-row">
                        <div class="hour">@hour.Label</div>
                        <div class="bar-track">
                            <div class="bar-fill @BarClass(hour.PressurePct)" style="width:@(Math.Max(hour.PressurePct, 2).ToString("0", System.Globalization.CultureInfo.InvariantCulture))%"></div>
                        </div>
                        <div class="detail">@hour.WentRound went round / @total</div>
                    </div>
                }
            </div>
        }

        @if (Model.ProblemVehicles.Count > 0)
        {
            <div class="panel" style="padding:0; overflow:hidden;">
                <div style="padding:16px 16px 8px;">
                    <h2>Vehicles that struggled most</h2>
                    <div class="hint">The units losing the most time going round instead of loading. Fewer than 5 arrivals are not shown.</div>
                </div>
                <div class="table-wrap">
                    <table style="box-shadow:none;">
                        <thead>
                            <tr>
                                <th>Vehicle</th>
                                <th>Trips loaded</th>
                                <th>Went round</th>
                                <th>Miss rate</th>
                                <th>Avg time in bay</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var vehicle in Model.ProblemVehicles)
                            {
                                <tr>
                                    <td><strong>@vehicle.Vehicle</strong></td>
                                    <td>@vehicle.Trips.ToString("N0")</td>
                                    <td>@vehicle.WentRound.ToString("N0")</td>
                                    <td><span class="pill @Tone(vehicle.PressurePct)">@vehicle.PressurePct.ToString("0")%</span></td>
                                    <td>@vehicle.AverageLoadingMinutes.ToString("0.#") min</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }

        @if (Model.LoadingPointRows.Count > 0)
        {
            <div class="panel" style="padding:0; overflow:hidden;">
                <div style="padding:16px 16px 8px;">
                    <h2>Loading points</h2>
                    <div class="hint">A low success rate usually means vehicles pass through the fence rather than loading there.</div>
                </div>
                <div class="table-wrap">
                    <table style="box-shadow:none;">
                        <thead>
                            <tr>
                                <th>Loading point</th>
                                <th>Trips loaded</th>
                                <th>Went round</th>
                                <th>Success rate</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var point in Model.LoadingPointRows)
                            {
                                <tr>
                                    <td><strong>@point.Name</strong></td>
                                    <td>@point.Trips.ToString("N0")</td>
                                    <td>@point.WentRound.ToString("N0")</td>
                                    <td><span class="pill @(point.SuccessPct >= 50 ? "low" : point.SuccessPct >= 25 ? "medium" : "high")">@point.SuccessPct.ToString("0")%</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    }

    <div class="footer">
        A trip = a vehicle that entered a loading point and stayed long enough to load. "Went round" = it found the bay occupied and looped back.<br />
        Data from vehicle tracking, @retrievedAt.ToString("dd MMM yyyy HH:mm")
    </div>
</body>
</html>
