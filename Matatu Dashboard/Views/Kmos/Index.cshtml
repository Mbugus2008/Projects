@model Matatu_Dashboard.Models.KmosDashboardViewModel
@{
    Layout = null;
    var selectedRange = Model.Range;
    var pathBase = Context.Request.PathBase.HasValue ? Context.Request.PathBase.Value! : string.Empty;
    var baseUrl = string.IsNullOrWhiteSpace(pathBase) ? "/kmos" : $"{pathBase}/kmos";

    string Money(decimal value) => "KES " + value.ToString("N0");
    string Pct(double value, double max) => max <= 0 ? "0%" : ((value / max) * 100).ToString("0.#") + "%";
    string SmsText(string message) => message.Replace("\\n", " ").Replace("\r", " ").Replace("\n", " ");
    double MaxBar(IEnumerable<Matatu_Dashboard.Models.KmosBarViewModel> bars) => bars.Any() ? bars.Max(bar => bar.Value) : 0;
    var trendMax = MaxBar(Model.CollectionsTrend);
    var weekMax = Model.WeeklyCollections.Any() ? Model.WeeklyCollections.Max(bar => bar.Value) : 0;
    var typeMax = Model.TypeMix.Any() ? Model.TypeMix.Max(type => (double)type.Amount) : 0;
    var statusMax = MaxBar(Model.MemberStatuses);
    var vehicleTypeMax = MaxBar(Model.VehicleTypes);
    var loanTypeMax = MaxBar(Model.LoanTypes);
    var agentMax = Model.TopAgents.Any() ? (double)Model.TopAgents.Max(agent => agent.Amount) : 0;
    var plateMax = Model.TopVehicles.Any() ? (double)Model.TopVehicles.Max(plate => plate.Amount) : 0;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"]</title>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;700&family=Space+Grotesk:wght@500;700&display=swap" rel="stylesheet">
    <style>
        :root { color-scheme: light; }
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: 'DM Sans', sans-serif; background: #f4f6f9; color: #1a1a2e; padding: 16px; }
        .header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px; flex-wrap: wrap; gap: 8px; }
        .header h1 { font-size: 20px; font-weight: 700; }
        .header .sub { font-size: 12px; color: #888; margin-top: 2px; }
        .tabs { display: flex; gap: 4px; flex-wrap: wrap; }
        .tabs a { padding: 6px 14px; border-radius: 6px; text-decoration: none; font-size: 13px; font-weight: 500; color: #555; background: #e8ecf1; }
        .tabs a.active { background: #7a1f2b; color: #fff; }
        .metrics { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 10px; margin-bottom: 16px; }
        .metric-card { background: #fff; border-radius: 10px; padding: 14px; box-shadow: 0 1px 3px rgba(0,0,0,.08); }
        .metric-card .label { font-size: 11px; color: #888; text-transform: uppercase; letter-spacing: .5px; }
        .metric-card .value { font-size: 22px; font-weight: 700; color: #263238; margin-top: 4px; }
        .metric-card .value.good { color: #006B3F; }
        .metric-card .value.warn { color: #c62828; }
        .metric-card .value.info { color: #1565c0; }
        .metric-card .value.compact { font-size: 17px; letter-spacing: -.2px; }
        .metric-card .note { font-size: 11px; color: #999; margin-top: 3px; }
        .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 16px; align-items: start; }
        .panel { background: #fff; border-radius: 10px; padding: 16px; box-shadow: 0 1px 3px rgba(0,0,0,.08); margin-bottom: 16px; }
        .panel h2 { font-size: 14px; font-weight: 700; margin-bottom: 4px; }
        .panel .hint { font-size: 12px; color: #888; margin-bottom: 12px; }
        .bar-row { display: grid; grid-template-columns: 118px 1fr 92px; align-items: center; gap: 10px; padding: 3px 0; }
        .bar-row .name { font-size: 12.5px; color: #444; font-weight: 500; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
        .bar-track { background: #eef1f5; border-radius: 4px; height: 16px; overflow: hidden; }
        .bar-fill { height: 100%; border-radius: 4px; background: #7a1f2b; }
        .bar-fill.alt { background: #1565c0; }
        .bar-fill.warm { background: #ef6c00; }
        .bar-fill.good { background: #0f766e; }
        .bar-row .detail { font-size: 12px; color: #666; text-align: right; }
        .legend { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 10px; }
        .legend span { font-size: 11px; padding: 2px 8px; border-radius: 10px; background: #eef1f5; color: #555; }
        .legend span.off { background: #fdecea; color: #b71c1c; }
        .table-wrap { width: 100%; overflow-x: auto; -webkit-overflow-scrolling: touch; }
        table { width: 100%; border-collapse: collapse; }
        th { background: #7a1f2b; color: #fff; padding: 9px 8px; font-size: 12px; text-align: left; white-space: nowrap; position: sticky; top: 0; }
        td { padding: 8px; font-size: 13px; border-bottom: 1px solid #eee; white-space: nowrap; }
        tr:last-child td { border-bottom: none; }
        td.num { text-align: right; font-variant-numeric: tabular-nums; }
        td.msg { white-space: normal; max-width: 460px; min-width: 240px; font-size: 12.5px; color: #444; }
        .rank-bar { height: 6px; border-radius: 3px; background: #eef1f5; overflow: hidden; margin-top: 4px; }
        .rank-bar i { display: block; height: 100%; background: #7a1f2b; }
        .pill { display: inline-block; padding: 2px 8px; border-radius: 10px; font-size: 11.5px; font-weight: 700; background: #e8f5e9; color: #2e7d32; }
        .pill.off { background: #fdecea; color: #c62828; }
        .error { background: #fdecea; color: #b71c1c; border-radius: 8px; padding: 12px 14px; font-size: 13px; margin-bottom: 16px; }
        .notice { background: #fff4e5; color: #8a4b00; border-radius: 8px; padding: 12px 14px; font-size: 13px; margin-bottom: 16px; border-left: 4px solid #ef6c00; }
        .empty { background: #fff; border-radius: 10px; padding: 28px; text-align: center; color: #777; font-size: 13.5px; box-shadow: 0 1px 3px rgba(0,0,0,.08); }
        .footer { margin-top: 12px; font-size: 11px; color: #999; text-align: center; }
        @@media (max-width: 640px) {
            body { padding: 10px; }
            .header { flex-direction: column; align-items: flex-start; }
            .header h1 { font-size: 17px; }
            .tabs a { padding: 5px 10px; font-size: 12px; }
            .metrics { grid-template-columns: repeat(2, 1fr); gap: 8px; }
            .metric-card { padding: 10px; }
            .metric-card .value { font-size: 18px; }
            .metric-card .label { font-size: 10px; }
            .bar-row { grid-template-columns: 74px 1fr 78px; gap: 6px; }
            .bar-row .detail { font-size: 11px; }
        }
    </style>
    <style>
        /* --- polish pass: same markup, softer surfaces and a proper masthead --- */
        body {
            background: radial-gradient(1100px 460px at 12% -12%, #ffffff 0%, #f1f4f9 58%, #edf0f7 100%);
            color: #16202e;
            padding: 18px 20px 26px;
            -webkit-font-smoothing: antialiased;
        }

        /* Standalone page: no dashboard sidebar, so the content is centred on a max width. */
        body > * { max-width: 1560px; margin-left: auto; margin-right: auto; }

        .masthead {
            position: relative;
            overflow: hidden;
            display: flex;
            justify-content: space-between;
            align-items: flex-end;
            gap: 18px;
            flex-wrap: wrap;
            padding: 22px 24px;
            margin-bottom: 18px;
            border-radius: 22px;
            color: #fff;
            background: linear-gradient(115deg, #4d1019 0%, #7a1f2b 46%, #a8323f 100%);
            box-shadow: 0 22px 44px -30px rgba(122, 31, 43, .9);
        }

        .masthead::after {
            content: "";
            position: absolute;
            right: -70px;
            bottom: -130px;
            width: 300px;
            height: 300px;
            border-radius: 50%;
            background: rgba(255, 255, 255, .07);
        }

        .masthead > div { position: relative; z-index: 1; }

        .masthead .eyebrow {
            font-size: 10.5px;
            font-weight: 700;
            letter-spacing: .18em;
            text-transform: uppercase;
            color: rgba(255, 255, 255, .72);
        }

        .masthead h1 {
            font-family: 'Space Grotesk', 'DM Sans', sans-serif;
            font-size: 27px;
            line-height: 1.08;
            letter-spacing: -.015em;
            margin-top: 6px;
        }

        .masthead .sub { font-size: 12.5px; color: rgba(255, 255, 255, .78); margin-top: 7px; }

        .tabs { position: relative; z-index: 1; }
        .tabs a {
            padding: 8px 15px;
            border-radius: 999px;
            font-size: 12.5px;
            font-weight: 600;
            color: rgba(255, 255, 255, .86);
            background: rgba(255, 255, 255, .13);
            border: 1px solid rgba(255, 255, 255, .18);
            transition: background .15s, color .15s;
        }
        .tabs a:hover { background: rgba(255, 255, 255, .24); }
        .tabs a.active { background: #fff; color: #7a1f2b; border-color: #fff; }

        .metrics { gap: 12px; margin-bottom: 18px; grid-template-columns: repeat(auto-fit, minmax(min(170px, 100%), 1fr)); }
        .metric-card {
            position: relative;
            overflow: hidden;
            padding: 16px 16px 15px;
            border: 1px solid #e6ebf2;
            border-radius: 16px;
            box-shadow: 0 1px 2px rgba(16, 24, 40, .04), 0 16px 30px -26px rgba(16, 24, 40, .45);
            transition: transform .15s ease;
        }
        .metric-card:hover { transform: translateY(-2px); }
        .metric-card::before {
            content: "";
            position: absolute;
            left: 0;
            top: 0;
            bottom: 0;
            width: 4px;
            background: #cbd5e1;
        }
        .metric-card.good::before { background: linear-gradient(180deg, #0f766e, #14b8a6); }
        .metric-card.warn::before { background: linear-gradient(180deg, #b91c1c, #ef4444); }
        .metric-card.info::before { background: linear-gradient(180deg, #1d4ed8, #3b82f6); }
        .metric-card .label { font-size: 10.5px; font-weight: 700; letter-spacing: .09em; color: #6b7787; }
        .metric-card .value {
            font-family: 'Space Grotesk', 'DM Sans', sans-serif;
            font-size: 24px;
            letter-spacing: -.02em;
            margin-top: 8px;
            color: #16202e;
            font-variant-numeric: tabular-nums;
        }
        .metric-card .value.compact { font-size: 18px; }
        .metric-card .note { font-size: 11.5px; color: #7b8798; margin-top: 6px; }

        /* min() keeps a single column from forcing a horizontal scrollbar on narrow panes. */
        .grid { gap: 16px; grid-template-columns: repeat(auto-fit, minmax(min(460px, 100%), 1fr)); }
        .panel {
            border: 1px solid #e6ebf2;
            border-radius: 16px;
            padding: 18px;
            box-shadow: 0 1px 2px rgba(16, 24, 40, .04), 0 16px 30px -26px rgba(16, 24, 40, .45);
        }
        .panel h2 { font-family: 'Space Grotesk', 'DM Sans', sans-serif; font-size: 14.5px; letter-spacing: -.01em; }
        .panel h2::after {
            content: "";
            display: block;
            width: 34px;
            height: 3px;
            margin-top: 7px;
            border-radius: 2px;
            background: linear-gradient(90deg, #a8323f, #e2a3aa);
        }
        .panel .hint { font-size: 11.5px; color: #7b8798; margin: 9px 0 14px; line-height: 1.5; }

        .bar-row { grid-template-columns: 118px 1fr 96px; padding: 4px 0; }
        .bar-row .name { font-size: 12px; font-weight: 600; color: #3d4757; }
        .bar-track { height: 10px; border-radius: 999px; background: #eef1f6; }
        .bar-fill { border-radius: 999px; background: linear-gradient(90deg, #8f2733, #c1444f); }
        .bar-fill.alt { background: linear-gradient(90deg, #1d4ed8, #3b82f6); }
        .bar-fill.warm { background: linear-gradient(90deg, #c2410c, #f97316); }
        .bar-fill.good { background: linear-gradient(90deg, #0f766e, #14b8a6); }
        .bar-row .detail { font-size: 11.5px; color: #4a5666; font-variant-numeric: tabular-nums; }

        th {
            position: static;
            background: #f7f9fc;
            color: #5b6676;
            font-size: 10.5px;
            font-weight: 700;
            letter-spacing: .07em;
            text-transform: uppercase;
            border-bottom: 1px solid #e6ebf2;
            padding: 10px 8px;
        }
        td { font-size: 12.5px; padding: 9px 8px; border-bottom: 1px solid #f1f4f8; }
        tbody tr:hover td { background: #fafbfd; }
        td.num { font-weight: 600; color: #26313f; }

        .legend span { background: #f2f5f9; color: #5b6676; border: 1px solid #e6ebf2; }
        .rank-bar { height: 4px; background: #eef1f6; }
        .rank-bar i { background: linear-gradient(90deg, #a8323f, #d4737c); }

        .error, .notice, .empty { border-radius: 14px; box-shadow: 0 1px 2px rgba(16, 24, 40, .04); }
        .footer { margin-top: 16px; color: #98a3b3; }

        @@media (min-width: 1100px) {
            /* Eight tiles read best as two tidy rows of four on a desktop screen. */
            .metrics { grid-template-columns: repeat(4, 1fr); }
        }

        @@media (max-width: 900px) {
            .masthead { align-items: flex-start; }
            .masthead h1 { font-size: 22px; }
        }

        @@media (max-width: 640px) {
            body { padding: 12px; }
            .metrics { grid-template-columns: repeat(2, 1fr); }
            .metric-card .value { font-size: 19px; }
            .bar-row { grid-template-columns: 88px 1fr 84px; }
        }
    </style>
</head>
<body>
    <div class="masthead">
        <div>
            <div class="eyebrow">KMOS · Company KMO</div>
            <h1>KMOS Dashboard</h1>
            <div class="sub">
                Company KMO · @Model.RangeStart.ToString("dd MMM yyyy") – @Model.RangeEnd.AddDays(-1).ToString("dd MMM yyyy")
                · retrieved @Model.RetrievedAt.ToString("HH:mm")
            </div>
        </div>
        <div class="tabs">
            <a href="@baseUrl/today" class="@(selectedRange == "today" ? "active" : "")">Today</a>
            <a href="@baseUrl/yesterday" class="@(selectedRange == "yesterday" ? "active" : "")">Yesterday</a>
            <a href="@baseUrl/week" class="@(selectedRange == "week" ? "active" : "")">This week</a>
            <a href="@baseUrl/month" class="@(selectedRange == "month" ? "active" : "")">This month</a>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="error">Could not load KMOS data: @Model.ErrorMessage</div>
    }

    @if (Model.Truncated)
    {
        <div class="notice">
            This period holds more records than one page can read, so the figures below cover the
            start of it only. Use today or yesterday for a complete picture.
        </div>
    }

    @if (!Model.HasData)
    {
        @if (string.IsNullOrWhiteSpace(Model.ErrorMessage))
        {
            <div class="empty">No KMOS data available for this period.</div>
        }
    }
    else
    {
        <div class="metrics">
            @foreach (var tile in Model.Tiles)
            {
                <div class="metric-card @tile.Tone">
                    <div class="label">@tile.Label</div>
                    <div class="value @tile.Tone @(tile.Value.Length > 10 ? "compact" : "")">@tile.Value</div>
                    <div class="note">@tile.Note</div>
                </div>
            }
        </div>

        <div class="grid">
            <div class="panel">
                <h2>@Model.CollectionsTrendTitle</h2>
                <div class="hint">Transactions posted in the selected period.</div>
                @if (Model.CollectionsTrend.Count == 0)
                {
                    <div class="hint">No transactions in this period.</div>
                }
                else
                {
                    @foreach (var bar in Model.CollectionsTrend)
                    {
                        <div class="bar-row">
                            <div class="name">@bar.Label</div>
                            <div class="bar-track"><div class="bar-fill" style="width:@Pct(bar.Value, trendMax)"></div></div>
                            <div class="detail">@bar.Display</div>
                        </div>
                    }
                }
            </div>

            <div class="panel">
                <h2>Collections — last 7 days</h2>
                <div class="hint">Value collected per day, always the last seven days (independent of the selected period).</div>
                @if (Model.WeeklyCollections.Count == 0 || Model.WeeklyCollections.All(bar => bar.Value == 0))
                {
                    <div class="hint">No collections recorded in the last seven days.</div>
                }
                else
                {
                    @foreach (var bar in Model.WeeklyCollections)
                    {
                        <div class="bar-row">
                            <div class="name">@bar.Label</div>
                            <div class="bar-track"><div class="bar-fill good" style="width:@Pct(bar.Value, weekMax)"></div></div>
                            <div class="detail">@bar.Display</div>
                        </div>
                    }
                }
            </div>

            <div class="panel">
                <h2>Collections by type</h2>
                <div class="hint">@Money(Model.CollectedTotal) collected across @Model.TransactionCount transactions@(Model.ReversedCount > 0 ? $", excluding {Model.ReversedCount} reversed" : "").</div>
                @if (Model.TypeMix.Count == 0)
                {
                    <div class="hint">Nothing recorded in this period.</div>
                }
                else
                {
                    @foreach (var type in Model.TypeMix)
                    {
                        <div class="bar-row">
                            <div class="name" title="@type.Code">@type.Name</div>
                            <div class="bar-track"><div class="bar-fill alt" style="width:@Pct((double)type.Amount, typeMax)"></div></div>
                            <div class="detail">@Money(type.Amount) · @type.Count</div>
                        </div>
                    }
                }
                @if (Model.TranstypeLegend.Count > 0)
                {
                    <div class="legend">
                        @foreach (var type in Model.TranstypeLegend)
                        {
                            <span class="@(type.Active ? "" : "off")" title="@type.Code">@type.Name</span>
                        }
                    </div>
                }
            </div>

            <div class="panel">
                <h2>Top agents</h2>
                <div class="hint">@Model.AgentCount agents registered in KMOS; ranked by value collected in this period.</div>
                <div class="table-wrap">
                    <table>
                        <thead>
                            <tr><th>Agent</th><th>Code</th><th style="text-align:right">Txns</th><th style="text-align:right">Collected</th></tr>
                        </thead>
                        <tbody>
                            @if (Model.TopAgents.Count == 0)
                            {
                                <tr><td colspan="4" style="color:#888">No agent activity in this period.</td></tr>
                            }
                            @foreach (var agent in Model.TopAgents)
                            {
                                <tr>
                                    <td>
                                        @agent.Name
                                        <div class="rank-bar"><i style="width:@Pct((double)agent.Amount, agentMax)"></i></div>
                                    </td>
                                    <td>@agent.Key</td>
                                    <td class="num">@agent.Count.ToString("N0")</td>
                                    <td class="num">@Money(agent.Amount)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="panel">
                <h2>Top vehicles</h2>
                <div class="hint">@Model.VehicleCount vehicles on the KMOS fleet; ranked by value collected in this period.</div>
                <div class="table-wrap">
                    <table>
                        <thead>
                            <tr><th>Vehicle</th><th style="text-align:right">Txns</th><th style="text-align:right">Collected</th></tr>
                        </thead>
                        <tbody>
                            @if (Model.TopVehicles.Count == 0)
                            {
                                <tr><td colspan="3" style="color:#888">No vehicle activity in this period.</td></tr>
                            }
                            @foreach (var plate in Model.TopVehicles)
                            {
                                <tr>
                                    <td>
                                        @plate.Name
                                        <div class="rank-bar"><i style="width:@Pct((double)plate.Amount, plateMax)"></i></div>
                                    </td>
                                    <td class="num">@plate.Count.ToString("N0")</td>
                                    <td class="num">@Money(plate.Amount)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="panel">
                <h2>Members</h2>
                <div class="hint">@Model.MemberCount members · @Model.ActiveMemberCount active · @Model.MembersWithActivity transacted in this period · loan arrears @Money(Model.LoanArrearsTotal) · penalties @Money(Model.PenaltyTotal) · savings @Money(Model.SavingsTotal)</div>
                @foreach (var bar in Model.MemberStatuses)
                {
                    <div class="bar-row">
                        <div class="name">@bar.Label</div>
                        <div class="bar-track"><div class="bar-fill" style="width:@Pct(bar.Value, statusMax)"></div></div>
                        <div class="detail">@bar.Display</div>
                    </div>
                }
                <div class="hint" style="margin:14px 0 6px">Highest loan arrears (members who transacted in this period)</div>
                <div class="table-wrap">
                    <table>
                        <thead>
                            <tr><th>No</th><th>Member</th><th>Phone</th><th>Status</th><th style="text-align:right">Txns</th><th style="text-align:right">Arrears</th><th style="text-align:right">Daily</th></tr>
                        </thead>
                        <tbody>
                            @if (Model.TopDebtors.Count == 0)
                            {
                                <tr><td colspan="7" style="color:#888">No member with arrears transacted in this period.</td></tr>
                            }
                            @foreach (var member in Model.TopDebtors)
                            {
                                <tr>
                                    <td>@member.No</td>
                                    <td>@member.Name</td>
                                    <td>@member.Phone</td>
                                    <td>@member.Status</td>
                                    <td class="num">@member.Transactions</td>
                                    <td class="num">@Money(member.LoanArrears)</td>
                                    <td class="num">@Money(member.DailyRepayment)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="panel">
                <h2>Fleet</h2>
                <div class="hint">@Model.VehicleCount vehicles · @Model.VehiclesWithActivity with activity in this period · arrears @Money(Model.VehicleArrearsTotal) · penalties @Money(Model.VehiclePenaltyTotal)</div>
                @foreach (var bar in Model.VehicleTypes)
                {
                    <div class="bar-row">
                        <div class="name">@bar.Label</div>
                        <div class="bar-track"><div class="bar-fill warm" style="width:@Pct(bar.Value, vehicleTypeMax)"></div></div>
                        <div class="detail">@bar.Display</div>
                    </div>
                }
                <div class="hint" style="margin:14px 0 6px">Vehicles in arrears (transacted in this period)</div>
                <div class="table-wrap">
                    <table>
                        <thead>
                            <tr><th>Vehicle</th><th>Type</th><th style="text-align:right">Txns</th><th style="text-align:right">Arrears</th><th style="text-align:right">Penalty</th><th style="text-align:right">Daily</th></tr>
                        </thead>
                        <tbody>
                            @if (Model.VehicleArrears.Count == 0)
                            {
                                <tr><td colspan="6" style="color:#888">No vehicle with arrears transacted in this period.</td></tr>
                            }
                            @foreach (var vehicle in Model.VehicleArrears)
                            {
                                <tr>
                                    <td>@vehicle.Number</td>
                                    <td>@vehicle.Type</td>
                                    <td class="num">@vehicle.Transactions</td>
                                    <td class="num">@Money(vehicle.Arrears)</td>
                                    <td class="num">@Money(vehicle.Penalty)</td>
                                    <td class="num">@Money(vehicle.DailyContribution)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="panel">
                <h2>Credits</h2>
                <div class="hint">@Model.CreditCount credit records in KMOS, grouped by loan product.</div>
                @foreach (var bar in Model.LoanTypes)
                {
                    <div class="bar-row">
                        <div class="name">@bar.Label</div>
                        <div class="bar-track"><div class="bar-fill alt" style="width:@Pct(bar.Value, loanTypeMax)"></div></div>
                        <div class="detail">@bar.Display</div>
                    </div>
                }
            </div>

            <div class="panel">
                <h2>SMS activity</h2>
                <div class="hint">@Model.SmsCount messages queued or sent in this period.</div>
                <div class="table-wrap">
                    <table>
                        <thead>
                            <tr><th>Entry</th><th>Date</th><th>Phone</th><th>Sent</th><th>Message</th></tr>
                        </thead>
                        <tbody>
                            @if (Model.RecentSms.Count == 0)
                            {
                                <tr><td colspan="5" style="color:#888">No SMS in this period.</td></tr>
                            }
                            @foreach (var message in Model.RecentSms)
                            {
                                <tr>
                                    <td>@message.EntryNo</td>
                                    <td>@(message.Date?.ToString("dd MMM") ?? "-")</td>
                                    <td>@message.Phone</td>
                                    <td><span class="pill @(string.Equals(message.Sent, "Yes", StringComparison.OrdinalIgnoreCase) ? "" : "off")">@message.Sent</span></td>
                                    <td class="msg">@SmsText(message.Message)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="panel">
            <h2>Recent transactions</h2>
            <div class="hint">Latest 25 postings in this period (KMOS ignores $orderby, so the ordering is applied after the read).</div>
            <div class="table-wrap">
                <table>
                    <thead>
                        <tr>
                            <th>Document</th><th>Date</th><th>Time</th><th>Type</th><th>Account</th>
                            <th>Vehicle</th><th>Agent</th><th style="text-align:right">Amount</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.RecentTransactions.Count == 0)
                        {
                            <tr><td colspan="8" style="color:#888">No transactions in this period.</td></tr>
                        }
                        @foreach (var transaction in Model.RecentTransactions)
                        {
                            <tr>
                                <td>@transaction.DocumentNo</td>
                                <td>@(transaction.Date?.ToString("dd MMM yyyy") ?? "-")</td>
                                <td>@transaction.Time</td>
                                <td>@transaction.Type</td>
                                <td>@transaction.AccountName</td>
                                <td>@transaction.Vehicle</td>
                                <td>@transaction.Agent</td>
                                <td class="num">@Money(transaction.Amount)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="footer">
            Source: @Model.ServiceUrl · cached for a couple of minutes · @Model.TransactionCount transactions read for @Model.RangeLabel.ToLowerInvariant()
        </div>
    }
</body>
</html>
