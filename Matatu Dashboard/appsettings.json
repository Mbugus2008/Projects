{
  "BusinessCentral": {
    "Username": "SET_IN_USER_SECRETS",
    "Password": "SET_IN_USER_SECRETS",
    "Domain": "",
    "UseDefaultCredentials": false,
    "PageSize": 1000,
    "CacheSeconds": 60,
    "ShareCacheSeconds": 300,
    "EnableSharePrewarm": true,
    "ShareWarmLeadSeconds": 60,
    "ShareWarmRanges": [ "today", "yesterday" ],
    "MaxRows": 100,
    "Sources": [
      {
        "Name": "Transactions",
        "Url": "http://trimline.co.ke:9993/City/ODataV4/Company('Mbranch')/Transactions",
        "FilterToToday": true,
        "DateField": "Transaction_Date"
      },
      {
        "Name": "Deport Fuel",
        "Url": "http://trimline.co.ke:9993/City/ODataV4/Company('Mbranch')/Deport_n_Fuel",
        "DateField": "Date",
        "MaxItemsToLoad": 1000
      }
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
