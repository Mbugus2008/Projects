@page "/Profile/Litigation/{Taxregno}"
@rendermode InteractiveServer
@inject Eproc.Services.Icprofile iprofile
@using Syncfusion.Blazor.Grids
@attribute [StreamRendering]
@{
    var Tool = (new List<string>() { "Search", "Add", "Edit", "Delete", "Update", "Cancel" });
}
<SfGrid DataSource="@model" ID="bdetails" Toolbar=@Tool>
    <GridEditSettings AllowAdding="true" AllowDeleting="true" AllowEditing="true" Mode="EditMode.Normal"></GridEditSettings>
    <GridEvents OnActionComplete="OnActionComplete" TValue="Lhistory.LitigationHistory"></GridEvents>

    <GridColumns>
        <Syncfusion.Blazor.Grids.GridColumn Field=@nameof(fields.Entry_No) Visible="false" IsPrimaryKey="true" HeaderText="Entry No" AllowEditing="false" AllowAdding="false"> </Syncfusion.Blazor.Grids.GridColumn>
        <Syncfusion.Blazor.Grids.GridColumn Field=@nameof(fields.Tax_Registration_No) IsPrimaryKey="true" HeaderText="Tax Registration No" AllowEditing="false" AllowAdding="false"> </Syncfusion.Blazor.Grids.GridColumn>
        <Syncfusion.Blazor.Grids.GridColumn Field=@nameof(fields.Year) HeaderText="Year"></Syncfusion.Blazor.Grids.GridColumn>
        <Syncfusion.Blazor.Grids.GridColumn Field=@nameof(fields.Award_for_or_Against) HeaderText="Award for or Against"></Syncfusion.Blazor.Grids.GridColumn>
        <Syncfusion.Blazor.Grids.GridColumn Field=@nameof(fields.Name_of_Client) HeaderText="Name of Client"></Syncfusion.Blazor.Grids.GridColumn>
        <Syncfusion.Blazor.Grids.GridColumn Field=@nameof(fields.Cause_of_Litigation_and_Matter) HeaderText="Cause of Litigation and Matter"></Syncfusion.Blazor.Grids.GridColumn>
        <Syncfusion.Blazor.Grids.GridColumn Field=@nameof(fields.Disputed_Amount) HeaderText="Disputed Amount" TextAlign="TextAlign.Right" Type="ColumnType.Double" EditType="EditType.NumericEdit"></Syncfusion.Blazor.Grids.GridColumn>
    
    </GridColumns>
</SfGrid>
@code {
    [Parameter]
    public string Taxregno { get; set; }
    List<Lhistory.LitigationHistory> model { get; set; } = new ();
    Lhistory.LitigationHistory_Fields fields;
    protected override async void OnInitialized()
    {
        model = await iprofile.getLhistory(Taxregno);
        StateHasChanged();
    }
    public void OnActionComplete(ActionEventArgs<Lhistory.LitigationHistory> args)
    {
        switch (args.RequestType)
        {
            case Syncfusion.Blazor.Grids.Action.Add: { args.Data.Tax_Registration_No = Taxregno; break; }
            case Syncfusion.Blazor.Grids.Action.Save:
                {

                    args.Data = iprofile.SaveData(args.Data).Result;

                    break;
                }
            case Syncfusion.Blazor.Grids.Action.Delete:
                {
                    iprofile.Delete(args.Data);
                    break;
                }
        }
    }
}

