@code {
    SfTab Tab;
    public bool Vertical { get; set; } = true;
    public List<Eproc.Services.Profilesstates> profilesstates { get; set; } = new();

    bool first { get; set; } = true;
    bool last { get; set; } = false;
    int selectedIndex { get; set; } = 0;
    private int currentTab = 1;
    [SupplyParameterFromForm]
    CompProfile.CompanyProfile profile { get; set; } =
        new CompProfile.CompanyProfile();
    public IEnumerable<string> category_Of_Business = Enum.GetNames(typeof(CompProfile.Category_of_Business));
    protected string UserEmail { get; private set; }

    List<Countries.Country> countries { get; set; } = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {

            var authenticationState = await userprovider.GetAuthenticationStateAsync();
            var user = authenticationState.User;
            ApplicationUser CurrentUser = null;
            if (user.Identity.IsAuthenticated)
            {
                CurrentUser = await UserManager.GetUserAsync(user);

                UserEmail = user.FindFirst(ClaimTypes.Email)?.Value;
            }
            else
            {
                // User is not authenticated
                UserEmail = "Anonymous";
            }
            profilesstates = await new Eproc.Services.Profilesstates().getstates(CurrentUser.TaxRegistrationNO);


            profile = await iprofile.getprofile(CurrentUser.TaxRegistrationNO /* "ASPPIQO8927N" */);
            if (profile == null)
                profile = new CompProfile.CompanyProfile();

            countries = await iprofile.getcountries();
        }
        catch (Exception)
        {


        }
        StateHasChanged();
    }
    public void OnTabSelected(SelectEventArgs args)
    {
        first = args.SelectedIndex == 0;
        last = args.SelectedIndex == Tab.Items.Count - 1;
        //var tabs = Tab.Items.Count;
        var index = args.SelectedIndex;
    }
    public void OnTabSelecting(SelectingEventArgs args)
    {

    } private void Moveforward()
    {
 
  
        selectedIndex = selectedIndex + 1;
        first = selectedIndex == 0;

    }
    private void Moveback()
    {

        selectedIndex = selectedIndex - 1;
        last = selectedIndex == Tab.Items.Count - 1;
    }
    private void HandleInvalidSubmit()
    {

    }

    class Statemanager
    {
        public bool Generalinfo { get; set; }
        public bool contact { get; set; }
        public bool Personel { get; set; }
        public bool Experience { get; set; }
        public bool bankdetails { get; set; }
        public bool Partnership { get; set; }
        public bool Questionnare { get; set; }
        public bool Attachment { get; set; }
        public bool litigation { get; set; }

    }
  
}