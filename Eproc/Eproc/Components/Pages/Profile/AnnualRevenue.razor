@page "/Profile/AnnualRevenue/{Taxregno}"
@rendermode InteractiveServer
@inject Eproc.Services.Icprofile iprofile
@using Microsoft.AspNetCore.Authorization
@using Syncfusion.Blazor.Grids
@attribute [StreamRendering]
@attribute [Authorize]
 @{
    var Tool = (new List<string>() { "Search", "Add", "Edit", "Delete", "Update", "Cancel" });
}
<SfGrid DataSource="@model" ID="Experience" Toolbar=@Tool>
    <GridEditSettings AllowAdding="true" AllowDeleting="true" AllowEditing="true" Mode="EditMode.Normal"></GridEditSettings>
    <GridEvents OnActionComplete="OnActionComplete" TValue="ARevenue.AnnualRevenue"></GridEvents>
    <GridColumns>
        <Syncfusion.Blazor.Grids.GridColumn Field=@nameof(fields.Entry_No) Visible="false" IsPrimaryKey="true" HeaderText="Entry No" AllowEditing="false" AllowAdding="false"> </Syncfusion.Blazor.Grids.GridColumn>
        <Syncfusion.Blazor.Grids.GridColumn Field=@nameof(fields.Tax_Registration_No) HeaderText="Tax Registration No" AllowEditing="false" AllowAdding="false"> </Syncfusion.Blazor.Grids.GridColumn>
        <Syncfusion.Blazor.Grids.GridColumn Field=@nameof(fields.Year) HeaderText="Year"></Syncfusion.Blazor.Grids.GridColumn>
        <Syncfusion.Blazor.Grids.GridColumn Field=@nameof(fields.Currency_Code) HeaderText="Currency Code"></Syncfusion.Blazor.Grids.GridColumn>
        <Syncfusion.Blazor.Grids.GridColumn Field=@nameof(fields.Annual_Revenue) HeaderText="Annual Revenue" TextAlign="TextAlign.Right" Type="ColumnType.Double" EditType="EditType.NumericEdit"></Syncfusion.Blazor.Grids.GridColumn>
        </GridColumns>
</SfGrid>
@code {
    [Parameter]
    public string Taxregno { get; set; }
    List<ARevenue.AnnualRevenue> model { get; set; } = new List<ARevenue.AnnualRevenue>();
    ARevenue.AnnualRevenue_Fields fields;
    protected override async void OnInitialized()
    {
        model = await iprofile.getarevenue(Taxregno);
        StateHasChanged();
    }
    public void OnActionComplete(ActionEventArgs<ARevenue.AnnualRevenue> args)
    {
        switch (args.RequestType)
        {
            case Syncfusion.Blazor.Grids.Action.Add: { args.Data.Tax_Registration_No = Taxregno; break; }
            case Syncfusion.Blazor.Grids.Action.Save:
                {

                    args.Data = iprofile.SaveData(args.Data).Result;

                    break;
                }
            case Syncfusion.Blazor.Grids.Action.Delete:
                {
                    iprofile.Delete(args.Data);
                    break;
                }
        }
    }
}

