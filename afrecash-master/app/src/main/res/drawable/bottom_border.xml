<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/white" />
        </shape>
    </item>

    <item
        android:left="-3dp"
        android:right="-2dp"
        android:top="-3dp">
        <shape>
            <solid android:color="@color/white" />
            <stroke
                android:width="2dp"
                android:color="@color/green_700" />
        </shape>
    </item>

</layer-list>